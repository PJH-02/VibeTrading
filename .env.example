# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Korean Market APIs
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NUMBER=
KIS_ACCOUNT_PRODUCT_CODE=
KIS_USE_MOCK=

# The ETF loop always uses this separate mock stock account namespace (01).
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
KIS_MOCK_ACCOUNT_NUMBER=
KIS_MOCK_ACCOUNT_PRODUCT_CODE=01

# Leveraged/inverse ETF orders use a second mock stock account.
KIS_MOCK2_APP_KEY=
KIS_MOCK2_APP_SECRET=
KIS_MOCK2_ACCOUNT_NUMBER=
KIS_MOCK2_ACCOUNT_PRODUCT_CODE=01
# Estimated commission for permission-denied counterfactual fills only.
ETF_ASSUMED_FEE_RATE=0.000148

KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT_NUMBER=
KIWOOM_ACCOUNT_PASSWORD=
KIWOOM_CERT_PASSWORD=
KIWOOM_USE_MOCK=

#토스 API
TOSS_API_KEY=
TOSS_API_SECRET=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# US Market APIs
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Note: US market data also uses KIS API (same credentials as above)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Crypto Market APIs
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

#BYBIT
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
BYBIT_TESTNET_REST_URL=
BYBIT_TESTNET_PRIVATE_WS_URL=

# LS read-only derivatives data.  Keys alone never enable a feed.
LS_APP_KEY=
LS_APP_SECRET=
# Set each flag only after checking this account's market-data terms and fee.
LS_KR_FUTURES_NO_EXTRA_FEE_CONFIRMED=false
LS_OVERSEAS_DELAYED_NO_EXTRA_FEE_CONFIRMED=false
LS_OVERSEAS_DELAYED_ENTITLEMENT_CONFIRMED=false
# Exact contract may be required if the LS master returns multiple maturities.
LS_ES_SYMBOL=
LS_NQ_SYMBOL=
LS_OVERSEAS_POLL_SECONDS=30

#BINANCE
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

#HYPE
HYPERLIQUID_API_KEY=
HYPERLIQUID_TESTNET_API_KEY=

#GRVT
GRVT_API_KEY=
GRVT_API_SECRET=
GRVT_ACCOUNT_ID=
GRVT_ADDRESS=
GRVT_TESTNET_API_KEY=
GRVT_TESTNET_API_SECRET=
GRVT_TESTNET_ACCOUNT_ID=
GRVT_TESTNET_ADDRESS=
# Broker environment affects authenticated trading only; collectors use public mainnet data.
GRVT_USE_TESTNET=true
GRVT_ORDER_SUBMIT_ENABLED=false
# Ed25519 public key / 32-byte private seed in hex. Register against ARCUS_ADDRESS.
ARCUS_API_KEY=
ARCUS_API_SECRET=
ARCUS_ADDRESS=
ARCUS_ACCOUNT_INDEX=0
ARCUS_USE_TESTNET=true
ARCUS_TESTNET_API_KEY=
ARCUS_TESTNET_API_SECRET=
ARCUS_TESTNET_ADDRESS=
ARCUS_ORDER_SUBMIT_ENABLED=false

#PARADEX
PARADEX_TRADING_PRIVATE_KEY=
PARADEX_TRADING_ADDRESS=
PARADEX_TRADING_PUBLIC_KEY=
PARADEX_TRADING_PRIVATE_KEY=
PARADEX_TRADING_ADDRESS=
PARADEX_TRADING_PUBLIC_KEY=

#BACKPACK
BACKPACK_API_KEY=
BACKPACK_API_SECRET=
# Storage safety and Ncloud Storage (credentials are Docker secrets)
VIBETRADING_DATA_ROOT=/data
VIBETRADING_STATE_DIR=/data/state
NATS_URL=nats://nats:4222
NATS_MARKET_STREAM_NAME=MARKET_DATA
NATS_OPERATIONS_STREAM_NAME=OPERATIONS
NATS_MAX_BYTES=1073741824
NATS_OPERATIONS_MAX_BYTES=67108864
NATS_ACK_WAIT_SECONDS=1200
NATS_MAX_ACK_PENDING=65536
PARQUET_FLUSH_SECONDS=900
PARQUET_FLUSH_BYTES=67108864
PARQUET_MAX_BUFFER_BYTES=134217728
PARQUET_TARGET_COMPACT_BYTES=67108864
PARQUET_MIN_FILE_AGE_MINUTES=5
STORAGE_RSS_FLUSH_BYTES=681574400
STORAGE_RSS_PAUSE_BYTES=838860800
# Data-disk safety policy.  Collection stops at 80% or less than 4 GiB free;
# it resumes only below 50% with at least 6 GiB free for 60 stable seconds.
STORAGE_RESERVE_GB=4
STORAGE_WARNING_USED_RATIO=0.60
STORAGE_DIRECT_UPLOAD_USED_RATIO=0.75
STORAGE_FAIL_CLOSED_USED_RATIO=0.80
STORAGE_CLEANUP_TARGET_USED_RATIO=0.40
STORAGE_RESUME_USED_RATIO=0.50
STORAGE_RESUME_FREE_GB=6
ARCHIVE_BACKEND=ncloud_storage
ARCHIVE_ENDPOINT=https://kr-private.ncloudstorage.com
ARCHIVE_REGION=kr
ARCHIVE_BUCKET=
ARCHIVE_PREFIX=vibetrading
ARCHIVE_ACCESS_KEY_FILE=/run/secrets/archive_access_key
ARCHIVE_SECRET_KEY_FILE=/run/secrets/archive_secret_key
ARCHIVE_UPLOAD_AFTER_SECONDS=300
ARCHIVE_UPLOAD_MAX_AGE_SECONDS=3600
ARCHIVE_LOCAL_RETENTION_SECONDS=21600
ARCHIVE_CACHE_MAX_BYTES=536870912

# Production immutable crypto event index: bounded negative-lookup filter.
# Positive matches still require exact lookup; 128 MiB needs the release RAM budget.
CRYPTO_EVENT_GLOBAL_FILTER_BYTES=134217728

# Private dashboard: secrets are set in the server-only /etc/vibetrading/dashboard.env.
# Exchange API keys and Timefolio passwords are never sent to the hosted dashboard.
DASHBOARD_SITE_URL=
DASHBOARD_INGEST_TOKEN=
DASHBOARD_SITE_BYPASS_TOKEN=
DASHBOARD_CRYPTO_VENUES=binance,bitget,bybit,grvt,arcus
DASHBOARD_CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
DASHBOARD_TIMEFOLIO_POLL_SECONDS=120
