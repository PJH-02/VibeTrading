# Configure these as Cloudflare Worker secrets/vars; do not commit real values.
VIEWER_ORIGIN=https://dashboard.example.invalid
VIEWER_TOKEN_SHA256=REPLACE_WITH_SHA256_OF_RANDOM_32_BYTE_VIEWER_TOKEN
VIEWER_SESSION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
VIEWER_OWNER_SCOPE=0123456789abcdef01234567
D1_OWNER_SCOPE_PROOF_REF=REQUIRED_APPROVED_SINGLE_OWNER_D1_EVIDENCE_REFERENCE
PRIVATE_SERVICE_TOKEN_SHA256=REPLACE_WITH_DIFFERENT_PRIVATE_SERVICE_TOKEN_SHA256

# Private binding proof is deployment metadata, not a public URL or secret.
PRIVATE_GATEWAY_BINDING=PRIVATE_DASHBOARD_SERVICE
PRIVATE_GATEWAY_PROOF_REF=REQUIRED_APPROVED_CUT01_CONNECTIVITY_EVIDENCE_REFERENCE
TLS_MODE=managed-existing-ingress
DNS_PROOF_REF=REQUIRED_APPROVED_CUT01_DNS_EVIDENCE_REFERENCE
TLS_PROOF_REF=REQUIRED_APPROVED_CUT01_TLS_EVIDENCE_REFERENCE
CERT_RENEWAL_PROOF_REF=REQUIRED_APPROVED_CUT01_CERT_RENEWAL_EVIDENCE_REFERENCE

# The bridge must retain a private trusted HTTPS Sites/gateway URL and existing
# ingest bearer contract. Do not point it at VIEWER_ORIGIN.
DASHBOARD_SITE_URL=https://private-sites-gateway.example.invalid
PUBLIC_BACKEND_BIND=none
PUBLIC_EXPOSED_PORTS=none
CREDENTIAL_MOUNTS=none
