{"type":"tool_use","timestamp":1792688335025,"sessionID":"ses_e9b72e4cfffeS6mdRRcprZsE5d","part":{"type":"tool","tool":"read","callID":"call_00_l8ve2yvpzjnqv6idhplyzyos","state":{"status":"completed","input":{"filePath":"/work/scripts/dev/status.py"},"output":"<path>/work/scripts/dev/status.py</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env python3\n2: \"\"\"Deterministic read-only status projection for the v3 refactoring DAG.\n3: \n4: Stdlib only. Reads the two canonical JSON files under docs/refactoring/vnext/\n5: (the original VN/TX stage plan plus R/O tooling tickets) and emits a bounded\n6: projection. It never writes canonical JSON and never infers completion from a\n7: substring of a status string.\n8: \"\"\"\n9: \n10: from __future__ import annotations\n11: \n12: import argparse\n13: import json\n14: import subprocess\n15: import sys\n16: from pathlib import Path\n17: \n18: VNEXT_DIR = Path(\"docs\") / \"refactoring\" / \"vnext\"\n19: TICKETS_CANONICAL = VNEXT_DIR / \"tickets_production.json\"\n20: STAGE_CANONICAL = VNEXT_DIR / \"stage_status.json\"\n21: \n22: COMPLETE_STAGE = \"COMPLETE_LOCAL_IMPLEMENTATION\"\n23: ORIGINAL_STAGES = {COMPLETE_STAGE, \"INCOMPLETE\", \"NOT_STARTED\"}\n24: TOOLING_COMPLETE_STATUS = \"ACCEPTED\"\n25: RUNNING_STATUS = \"RUNNING\"\n26: ACTIVE_EXECUTION_STATUSES = {\"RUNNING_LOCAL_REFACTORING\"}\n27: EXTERNAL_TASK_IDS = {\"VN20\"}\n28: \n29: STATE_COMPLETE = \"COMPLETE\"\n30: STATE_RUNNING = \"RUNNING\"\n31: STATE_EXTERNAL = \"EXTERNAL\"\n32: STATE_BLOCKED = \"BLOCKED\"\n33: STATE_READY = \"READY\"\n34: STATE_PAUSED = \"PAUSED_DISPATCH\"\n35: \n36: \n37: def _load_json(path: Path) -> dict:\n38:     if not path.is_file():\n39:         raise ValueError(f\"canonical file missing: {path}\")\n40:     try:\n41:         with path.open(\"r\", encoding=\"utf-8\") as fh:\n42:             data = json.load(fh)\n43:     except (OSError, json.JSONDecodeError) as exc:\n44:         raise ValueError(f\"cannot parse {path}: {exc}\") from exc\n45:     if not isinstance(data, dict):\n46:         raise ValueError(f\"{path} must contain a JSON object\")\n47:     return data\n48: \n49: \n50: def _require_str(value, label: str) -> str:\n51:     if not isinstance(value, str) or not value:\n52:         raise ValueError(f\"{label} must be a non-empty string\")\n53:     return value\n54: \n55: \n56: def _require_str_list(value, label: str) -> list:\n57:     if not isinstance(value, list) or not all(isinstance(x, str) for x in value):\n58:         raise ValueError(f\"{label} must be a list of strings\")\n59:     return sorted(value)\n60: \n61: \n62: def _execution_control(data: dict, label: str) -> dict:\n63:     ec = data.get(\"execution_control\")\n64:     if not isinstance(ec, dict):\n65:         raise ValueError(f\"{label}: execution_control object missing\")\n66:     status = _require_str(ec.get(\"status\"), f\"{label}: execution_control.status\")\n67:     if not isinstance(ec.get(\"start_next_ticket\"), bool):\n68:         raise ValueError(f\"{label}: execution_control.start_next_ticket must be boolean\")\n69:     last = _require_str(ec.get(\"last_completed_ticket\"), f\"{label}: execution_control.last_completed_ticket\")\n70:     return {\n71:         \"status\": status,\n72:         \"start_next_ticket\": ec[\"start_next_ticket\"],\n73:         \"last_completed_ticket\": last,\n74:         \"last_completed_tooling_ticket\": ec.get(\"last_completed_tooling_ticket\"),\n75:     }\n76: \n77: \n78: def _collect_tasks(tickets: dict) -> tuple:\n79:     \"\"\"Validate IDs, dependencies and cycles; return (original, tooling) records.\"\"\"\n80:     tasks = tickets.get(\"tasks\")\n81:     tooling = tickets.get(\"tooling_tasks\", [])\n82:     if not isinstance(tasks, list) or not tasks:\n83:         raise ValueError(\"tickets_production.json: tasks must be a non-empty list\")\n84:     if not isinstance(tooling, list):\n85:         raise ValueError(\"tickets_production.json: tooling_tasks must be a list\")\n86:     records, tooling_records, seen = [], [], set()\n87:     for raw in tasks:\n88:         records.append(_record(raw, \"VN/TX\", \"tasks\", seen))\n89:     for raw in tooling:\n90:         tooling_records.append(_record(raw, \"R/O\", \"tooling_tasks\", seen))\n91:     known = seen\n92:     all_records = records + tooling_records\n93:     for rec in all_records:\n94:         for dep in rec[\"depends_on\"]:\n95:             if dep not in known:\n96:                 raise ValueError(f\"{rec['task_id']} depends on unknown id: {dep}\")\n97:     _no_cycles(all_records)\n98:     return records, tooling_records\n99: \n100: \n101: def _record(raw, family: str, label: str, seen: set) -> dict:\n102:     tid = _require_str(raw.get(\"task_id\"), f\"{label}[].task_id\")\n103:     if tid in seen:\n104:         raise ValueError(f\"duplicate task_id: {tid}\")\n105:     seen.add(tid)\n106:     return {\n107:         \"task_id\": tid,\n108:         \"family\": family,\n109:         \"status\": _require_str(raw.get(\"status\"), f\"{tid}.status\"),\n110:         \"depends_on\": _require_str_list(raw.get(\"depends_on\"), f\"{tid}.depends_on\"),\n111:         \"stage_classification\": raw.get(\"stage_classification\"),\n112:     }\n113: \n114: \n115: def _no_cycles(records: list) -> None:\n116:     edges = {r[\"task_id\"]: r[\"depends_on\"] for r in records}\n117:     state: dict = {}\n118: \n119:     def visit(node: str) -> None:\n120:         if state.get(node) == 1:\n121:             raise ValueError(f\"dependency cycle involves {node}\")\n122:         if state.get(node) == 2:\n123:             return\n124:         state[node] = 1\n125:         for dep in edges[node]:\n126:             visit(dep)\n127:         state[node] = 2\n128: \n129:     for node in edges:\n130:         visit(node)\n131: \n132: \n133: def _stage_authority(stage: dict, records: list) -> tuple:\n134:     \"\"\"Validate stage_status.json; return (category_by_id, declared_counts).\"\"\"\n135:     declared = stage.get(\"counts\")\n136:     tasks = stage.get(\"tasks\")\n137:     if not isinstance(declared, dict) or not declared:\n138:         raise ValueError(\"stage_status.json: counts object missing\")\n139:     if not isinstance(tasks, list) or not tasks:\n140:         raise ValueError(\"stage_status.json: tasks must be a non-empty list\")\n141:     category_by_id, tally, seen = {}, {}, set()\n142:     for raw in tasks:\n143:         tid = _require_str(raw.get(\"task_id\"), \"stage_status tasks[].task_id\")\n144:         if tid in seen:\n145:             raise ValueError(f\"duplicate stage task_id: {tid}\")\n146:         seen.add(tid)\n147:         category = _require_str(raw.get(\"category\"), f\"{tid}.category\")\n148:         if category not in ORIGINAL_STAGES:\n149:             raise ValueError(f\"{tid}: unknown stage category {category}\")\n150:         category_by_id[tid] = category\n151:         tally[category] = tally.get(category, 0) + 1\n152:     original_ids = {r[\"task_id\"] for r in records}\n153:     if seen != original_ids:\n154:         raise ValueError(\n155:             \"stage_status.json: stage tasks do not match original VN/TX records \"\n156:             f\"(missing={sorted(original_ids - seen)}, extra={sorted(seen - original_ids)})\"\n157:         )\n158:     for category in sorted(set(declared) | set(tally)):\n159:         declared_value = declared.get(category, 0)\n160:         if not isinstance(declared_value, int) or declared_value != tally.get(category, 0):\n161:             raise ValueError(\n162:                 f\"stage count mismatch for {category}: declared={declared_value} \"\n163:                 f\"actual={tally.get(category, 0)}\"\n164:             )\n165:     return category_by_id, dict(declared)\n166: \n167: \n168: def load_status(root: Path) -> dict:\n169:     \"\"\"Build the deterministic read-only status projection (no writes).\"\"\"\n170:     root = Path(root)\n171:     tickets_path = root / TICKETS_CANONICAL\n172:     stage_path = root / STAGE_CANONICAL\n173:     tickets = _load_json(tickets_path)\n174:     stage_data = _load_json(stage_path)\n175:     tickets_ec = _execution_control(tickets, str(TICKETS_CANONICAL))\n176:     stage_ec = _execution_control(stage_data, str(STAGE_CANONICAL))\n177:     if tickets_ec[\"last_completed_ticket\"] != stage_ec[\"last_completed_ticket\"]:\n178:         raise ValueError(\n179:             \"last_completed_ticket conflict: \"\n180:             f\"tickets={tickets_ec['last_completed_ticket']} \"\n181:             f\"stage_status={stage_ec['last_completed_ticket']}\"\n182:         )\n183:     records, tooling_records = _collect_tasks(tickets)\n184:     category_by_id, stage_counts = _stage_authority(stage_data, records)\n185: \n186:     for rec in records:\n187:         if rec[\"stage_classification\"] is not None and rec[\"stage_classification\"] != category_by_id[rec[\"task_id\"]]:\n188:             raise ValueError(\n189:                 f\"{rec['task_id']}: stage_classification {rec['stage_classification']!r} \"\n190:                 f\"conflicts with stage category {category_by_id[rec['task_id']]!r}\"\n191:             )\n192: \n193:     all_records = records + tooling_records\n194:     ticket_ids = set(category_by_id)\n195:     complete_by_id: dict = {}\n196:     for rec in all_records:\n197:         if rec[\"family\"] == \"VN/TX\":\n198:             complete_by_id[rec[\"task_id\"]] = category_by_id[rec[\"task_id\"]] == COMPLETE_STAGE\n199:         else:\n200:             complete_by_id[rec[\"task_id\"]] = rec[\"status\"] == TOOLING_COMPLETE_STATUS\n201: \n202:     paused = any(ec[\"status\"] not in ACTIVE_EXECUTION_STATUSES for ec in (tickets_ec, stage_ec))\n203:     gates_open = not paused and tickets_ec[\"start_next_ticket\"] and stage_ec[\"start_next_ticket\"]\n204: \n205:     nodes = []\n206:     for rec in all_records:\n207:         tid = rec[\"task_id\"]\n208:         stage = category_by_id.get(tid)\n209:         running = rec[\"status\"] == RUNNING_STATUS\n210:         external = tid in EXTERNAL_TASK_IDS\n211:         missing = [dep for dep in rec[\"depends_on\"] if not complete_by_id[dep]]\n212:         ready = not complete_by_id[tid] and not running and not external and not missing and gates_open\n213:         if complete_by_id[tid]:\n214:             state = STATE_COMPLETE\n215:         elif running:\n216:             state = STATE_RUNNING\n217:         elif external:\n218:             state = STATE_EXTERNAL\n219:         elif missing:\n220:             state = STATE_BLOCKED\n221:         elif ready:\n222:             state = STATE_READY\n223:         else:\n224:             state = STATE_PAUSED\n225:         nodes.append(\n226:             {\n227:                 \"task_id\": tid,\n228:                 \"family\": rec[\"family\"],\n229:                 \"status\": rec[\"status\"],\n230:                 \"stage\": stage,\n231:                 \"depends_on\": rec[\"depends_on\"],\n232:                 \"complete\": complete_by_id[tid],\n233:                 \"running\": running,\n234:                 \"external\": external,\n235:                 \"missing_dependencies\": missing,\n236:                 \"state\": state,\n237:                 \"ready\": ready,\n238:             }\n239:         )\n240:     tooling_tally: dict = {}\n241:     for node in nodes:\n242:         if node[\"family\"] == \"R/O\":\n243:             tooling_tally[node[\"status\"]] = tooling_tally.get(node[\"status\"], 0) + 1\n244:     return {\n245:         \"schema_version\": 1,\n246:         \"sources\": {\"tickets\": str(TICKETS_CANONICAL), \"stage_status\": str(STAGE_CANONICAL)},\n247:         \"execution_control\": {\n248:             \"tickets_status\": tickets_ec[\"status\"],\n249:             \"stage_status_status\": stage_ec[\"status\"],\n250:             \"start_next_ticket\": {\n251:                 \"tickets\": tickets_ec[\"start_next_ticket\"],\n252:                 \"stage_status\": stage_ec[\"start_next_ticket\"],\n253:             },\n254:             \"paused\": paused,\n255:         },\n256:         \"counts\": stage_counts,\n257:         \"tooling_counts\": tooling_tally,\n258:         \"node_totals\": {\"VN_TX\": len(records), \"RO\": len(tooling_records)},\n259:         \"ready\": [n[\"task_id\"] for n in nodes if n[\"ready\"]],\n260:         \"running\": [n[\"task_id\"] for n in nodes if n[\"running\"]],\n261:         \"external\": [n[\"task_id\"] for n in nodes if n[\"external\"]],\n262:         \"nodes\": nodes,\n263:         \"paused\": paused,\n264:         \"last_completed_ticket\": tickets_ec[\"last_completed_ticket\"],\n265:         \"last_completed_tooling_ticket\": tickets_ec[\"last_completed_tooling_ticket\"],\n266:     }\n267: \n268: \n269: def render_markdown(status: dict, git_head: str) -> str:\n270:     lines = [\n271:         \"# Local status projection (v3)\",\n272:         \"\",\n273:         f\"Canonical sources: `{status['sources']['tickets']}`, `{status['sources']['stage_status']}`; \"\n274:         \"`context.json` is a bounded derived summary only.\",\n275:         f\"Git HEAD: `{git_head}`\",\n276:         \"\",\n277:         \"## Execution control\",\n278:         \"\",\n279:         f\"- tickets: `{status['execution_control']['tickets_status']}`; start_next_ticket=\"\n280:         f\"`{status['execution_control']['start_next_ticket']['tickets']}`\",\n281:         f\"- stage_status: `{status['execution_control']['stage_status_status']}`; start_next_ticket=\"\n282:         f\"`{status['execution_control']['start_next_ticket']['stage_status']}`\",\n283:         f\"- dispatch paused: `{status['paused']}`\",\n284:         \"\",\n285:         \"## Stage counts (VN/TX)\",\n286:         \"\",\n287:     ]\n288:     for category in sorted(status[\"counts\"]):\n289:         lines.append(f\"- {category}: {status['counts'][category]}\")\n290:     tooling = \", \".join(f\"{name} {value}\" for name, value in sorted(status[\"tooling_counts\"].items())) or \"none\"\n291:     lines += [\n292:         f\"- tooling (R/O): {tooling}\",\n293:         f\"- originals plus tooling: {status['node_totals']['VN_TX']} VN/TX nodes, \"\n294:         f\"{status['node_totals']['RO']} R/O nodes\",\n295:         \"\",\n296:         \"## Progress\",\n297:         \"\",\n298:         f\"- last completed ticket: `{status['last_completed_ticket']}`; last completed tooling \"\n299:         f\"ticket: `{status['last_completed_tooling_ticket']}`\",\n300:         f\"- running (no duplicate dispatch): {', '.join(f'`{x}`' for x in status['running']) or 'none'}\",\n301:         f\"- ready now (dispatch unlocked): {', '.join(f'`{x}`' for x in status['ready']) or 'none'}\",\n302:         f\"- external (never auto-run): {', '.join(f'`{x}`' for x in status['external']) or 'none'}\",\n303:         \"\",\n304:         \"Local/operational distinction: `COMPLETE_LOCAL_IMPLEMENTATION` marks local implementation\",\n305:         \"acceptance only; production, deploy and long-duration resource gates remain open. The\",\n306:         \"canonical record keeps the original VN/TX status strings, e.g. VN07 stays `INCOMPLETE` and\",\n307:         \"VN20 actual cutover/deletion is EXTERNAL and is never executed automatically.\",\n308:         \"\",\n309:     ]\n310:     return \"\\n\".join(lines)\n311: \n312: \n313: def _git_head(root: Path) -> str:\n314:     \"\"\"Record the current Git HEAD; when unavailable, UNKNOWN is explicit.\"\"\"\n315:     try:\n316:         completed = subprocess.run(\n317:             [\"git\", \"rev-parse\", \"HEAD\"], cwd=str(root), capture_output=True, text=True, timeout=10\n318:         )\n319:     except (OSError, subprocess.SubprocessError):\n320:         return \"UNKNOWN\"\n321:     if completed.returncode != 0:\n322:         return \"UNKNOWN\"\n323:     return completed.stdout.strip() or \"UNKNOWN\"\n324: \n325: \n326: def main(argv=None) -> int:\n327:     parser = argparse.ArgumentParser(description=\"Read-only v3 status projection (stdlib only).\")\n328:     parser.add_argument(\"--root\", default=\".\", help=\"repository root to read canonical JSON from\")\n329:     parser.add_argument(\"--json\", action=\"store_true\", help=\"emit JSON projection (default)\")\n330:     parser.add_argument(\"--markdown\", action=\"store_true\", help=\"render concise markdown status\")\n331:     args = parser.parse_args(argv)\n332:     try:\n333:         status = load_status(Path(args.root))\n334:     except ValueError as exc:\n335:         print(f\"status error: {exc}\", file=sys.stderr)\n336:         return 2\n337:     git_head = _git_head(Path(args.root))\n338:     if args.markdown:\n339:         print(render_markdown(status, git_head), end=\"\")\n340:     else:\n341:         status[\"git_head\"] = git_head\n342:         print(json.dumps(status, ensure_ascii=False, indent=2))\n343:     return 0\n344: \n345: \n346: if __name__ == \"__main__\":\n347:     raise SystemExit(main())\n\n(End of file - total 347 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n\"\"\"Deterministic read-only status projection for the v3 refactoring DAG.\n\nStdlib only. Reads the two canonical JSON files under docs/refactoring/vnext/\n(the original VN/TX stage plan plus R/O tooling tickets) and emits a bounded\nprojection. It never writes canonical JSON and never infers completion from a\nsubstring of a status string.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nVNEXT_DIR = Path(\"docs\") / \"refactoring\" / \"vnext\"\nTICKETS_CANONICAL = VNEXT_DIR / \"tickets_production.json\"\nSTAGE_CANONICAL = VNEXT_DIR / \"stage_status.json\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/work/scripts/dev/status.py","text":"#!/usr/bin/env python3\n\"\"\"Deterministic read-only status projection for the v3 refactoring DAG.\n\nStdlib only. Reads the two canonical JSON files under docs/refactoring/vnext/\n(the original VN/TX stage plan plus R/O tooling tickets) and emits a bounded\nprojection. It never writes canonical JSON and never infers completion from a\nsubstring of a status string.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nVNEXT_DIR = Path(\"docs\") / \"refactoring\" / \"vnext\"\nTICKETS_CANONICAL = VNEXT_DIR / \"tickets_production.json\"\nSTAGE_CANONICAL = VNEXT_DIR / \"stage_status.json\"\n\nCOMPLETE_STAGE = \"COMPLETE_LOCAL_IMPLEMENTATION\"\nORIGINAL_STAGES = {COMPLETE_STAGE, \"INCOMPLETE\", \"NOT_STARTED\"}\nTOOLING_COMPLETE_STATUS = \"ACCEPTED\"\nRUNNING_STATUS = \"RUNNING\"\nACTIVE_EXECUTION_STATUSES = {\"RUNNING_LOCAL_REFACTORING\"}\nEXTERNAL_TASK_IDS = {\"VN20\"}\n\nSTATE_COMPLETE = \"COMPLETE\"\nSTATE_RUNNING = \"RUNNING\"\nSTATE_EXTERNAL = \"EXTERNAL\"\nSTATE_BLOCKED = \"BLOCKED\"\nSTATE_READY = \"READY\"\nSTATE_PAUSED = \"PAUSED_DISPATCH\"\n\n\ndef _load_json(path: Path) -> dict:\n    if not path.is_file():\n        raise ValueError(f\"canonical file missing: {path}\")\n    try:\n        with path.open(\"r\", encoding=\"utf-8\") as fh:\n            data = json.load(fh)\n    except (OSError, json.JSONDecodeError) as exc:\n        raise ValueError(f\"cannot parse {path}: {exc}\") from exc\n    if not isinstance(data, dict):\n        raise ValueError(f\"{path} must contain a JSON object\")\n    return data\n\n\ndef _require_str(value, label: str) -> str:\n    if not isinstance(value, str) or not value:\n        raise ValueError(f\"{label} must be a non-empty string\")\n    return value\n\n\ndef _require_str_list(value, label: str) -> list:\n    if not isinstance(value, list) or not all(isinstance(x, str) for x in value):\n        raise ValueError(f\"{label} must be a list of strings\")\n    return sorted(value)\n\n\ndef _execution_control(data: dict, label: str) -> dict:\n    ec = data.get(\"execution_control\")\n    if not isinstance(ec, dict):\n        raise ValueError(f\"{label}: execution_control object missing\")\n    status = _require_str(ec.get(\"status\"), f\"{label}: execution_control.status\")\n    if not isinstance(ec.get(\"start_next_ticket\"), bool):\n        raise ValueError(f\"{label}: execution_control.start_next_ticket must be boolean\")\n    last = _require_str(ec.get(\"last_completed_ticket\"), f\"{label}: execution_control.last_completed_ticket\")\n    return {\n        \"status\": status,\n        \"start_next_ticket\": ec[\"start_next_ticket\"],\n        \"last_completed_ticket\": last,\n        \"last_completed_tooling_ticket\": ec.get(\"last_completed_tooling_ticket\"),\n    }\n\n\ndef _collect_tasks(tickets: dict) -> tuple:\n    \"\"\"Validate IDs, dependencies and cycles; return (original, tooling) records.\"\"\"\n    tasks = tickets.get(\"tasks\")\n    tooling = tickets.get(\"tooling_tasks\", [])\n    if not isinstance(tasks, list) or not tasks:\n        raise ValueError(\"tickets_production.json: tasks must be a non-empty list\")\n    if not isinstance(tooling, list):\n        raise ValueError(\"tickets_production.json: tooling_tasks must be a list\")\n    records, tooling_records, seen = [], [], set()\n    for raw in tasks:\n        records.append(_record(raw, \"VN/TX\", \"tasks\", seen))\n    for raw in tooling:\n        tooling_records.append(_record(raw, \"R/O\", \"tooling_tasks\", seen))\n    known = seen\n    all_records = records + tooling_records\n    for rec in all_records:\n        for dep in rec[\"depends_on\"]:\n            if dep not in known:\n                raise ValueError(f\"{rec['task_id']} depends on unknown id: {dep}\")\n    _no_cycles(all_records)\n    return records, tooling_records\n\n\ndef _record(raw, family: str, label: str, seen: set) -> dict:\n    tid = _require_str(raw.get(\"task_id\"), f\"{label}[].task_id\")\n    if tid in seen:\n        raise ValueError(f\"duplicate task_id: {tid}\")\n    seen.add(tid)\n    return {\n        \"task_id\": tid,\n        \"family\": family,\n        \"status\": _require_str(raw.get(\"status\"), f\"{tid}.status\"),\n        \"depends_on\": _require_str_list(raw.get(\"depends_on\"), f\"{tid}.depends_on\"),\n        \"stage_classification\": raw.get(\"stage_classification\"),\n    }\n\n\ndef _no_cycles(records: list) -> None:\n    edges = {r[\"task_id\"]: r[\"depends_on\"] for r in records}\n    state: dict = {}\n\n    def visit(node: str) -> None:\n        if state.get(node) == 1:\n            raise ValueError(f\"dependency cycle involves {node}\")\n        if state.get(node) == 2:\n            return\n        state[node] = 1\n        for dep in edges[node]:\n            visit(dep)\n        state[node] = 2\n\n    for node in edges:\n        visit(node)\n\n\ndef _stage_authority(stage: dict, records: list) -> tuple:\n    \"\"\"Validate stage_status.json; return (category_by_id, declared_counts).\"\"\"\n    declared = stage.get(\"counts\")\n    tasks = stage.get(\"tasks\")\n    if not isinstance(declared, dict) or not declared:\n        raise ValueError(\"stage_status.json: counts object missing\")\n    if not isinstance(tasks, list) or not tasks:\n        raise ValueError(\"stage_status.json: tasks must be a non-empty list\")\n    category_by_id, tally, seen = {}, {}, set()\n    for raw in tasks:\n        tid = _require_str(raw.get(\"task_id\"), \"stage_status tasks[].task_id\")\n        if tid in seen:\n            raise ValueError(f\"duplicate stage task_id: {tid}\")\n        seen.add(tid)\n        category = _require_str(raw.get(\"category\"), f\"{tid}.category\")\n        if category not in ORIGINAL_STAGES:\n            raise ValueError(f\"{tid}: unknown stage category {category}\")\n        category_by_id[tid] = category\n        tally[category] = tally.get(category, 0) + 1\n    original_ids = {r[\"task_id\"] for r in records}\n    if seen != original_ids:\n        raise ValueError(\n            \"stage_status.json: stage tasks do not match original VN/TX records \"\n            f\"(missing={sorted(original_ids - seen)}, extra={sorted(seen - original_ids)})\"\n        )\n    for category in sorted(set(declared) | set(tally)):\n        declared_value = declared.get(category, 0)\n        if not isinstance(declared_value, int) or declared_value != tally.get(category, 0):\n            raise ValueError(\n                f\"stage count mismatch for {category}: declared={declared_value} \"\n                f\"actual={tally.get(category, 0)}\"\n            )\n    return category_by_id, dict(declared)\n\n\ndef load_status(root: Path) -> dict:\n    \"\"\"Build the deterministic read-only status projection (no writes).\"\"\"\n    root = Path(root)\n    tickets_path = root / TICKETS_CANONICAL\n    stage_path = root / STAGE_CANONICAL\n    tickets = _load_json(tickets_path)\n    stage_data = _load_json(stage_path)\n    tickets_ec = _execution_control(tickets, str(TICKETS_CANONICAL))\n    stage_ec = _execution_control(stage_data, str(STAGE_CANONICAL))\n    if tickets_ec[\"last_completed_ticket\"] != stage_ec[\"last_completed_ticket\"]:\n        raise ValueError(\n            \"last_completed_ticket conflict: \"\n            f\"tickets={tickets_ec['last_completed_ticket']} \"\n            f\"stage_status={stage_ec['last_completed_ticket']}\"\n        )\n    records, tooling_records = _collect_tasks(tickets)\n    category_by_id, stage_counts = _stage_authority(stage_data, records)\n\n    for rec in records:\n        if rec[\"stage_classification\"] is not None and rec[\"stage_classification\"] != category_by_id[rec[\"task_id\"]]:\n            raise ValueError(\n                f\"{rec['task_id']}: stage_classification {rec['stage_classification']!r} \"\n                f\"conflicts with stage category {category_by_id[rec['task_id']]!r}\"\n            )\n\n    all_records = records + tooling_records\n    ticket_ids = set(category_by_id)\n    complete_by_id: dict = {}\n    for rec in all_records:\n        if rec[\"family\"] == \"VN/TX\":\n            complete_by_id[rec[\"task_id\"]] = category_by_id[rec[\"task_id\"]] == COMPLETE_STAGE\n        else:\n            complete_by_id[rec[\"task_id\"]] = rec[\"status\"] == TOOLING_COMPLETE_STATUS\n\n    paused = any(ec[\"status\"] not in ACTIVE_EXECUTION_STATUSES for ec in (tickets_ec, stage_ec))\n    gates_open = not paused and tickets_ec[\"start_next_ticket\"] and stage_ec[\"start_next_ticket\"]\n\n    nodes = []\n    for rec in all_records:\n        tid = rec[\"task_id\"]\n        stage = category_by_id.get(tid)\n        running = rec[\"status\"] == RUNNING_STATUS\n        external = tid in EXTERNAL_TASK_IDS\n        missing = [dep for dep in rec[\"depends_on\"] if not complete_by_id[dep]]\n        ready = not complete_by_id[tid] and not running and not external and not missing and gates_open\n        if complete_by_id[tid]:\n            state = STATE_COMPLETE\n        elif running:\n            state = STATE_RUNNING\n        elif external:\n            state = STATE_EXTERNAL\n        elif missing:\n            state = STATE_BLOCKED\n        elif ready:\n            state = STATE_READY\n        else:\n            state = STATE_PAUSED\n        nodes.append(\n            {\n                \"task_id\": tid,\n                \"family\": rec[\"family\"],\n                \"status\": rec[\"status\"],\n                \"stage\": stage,\n                \"depends_on\": rec[\"depends_on\"],\n                \"complete\": complete_by_id[tid],\n                \"running\": running,\n                \"external\": external,\n                \"missing_dependencies\": missing,\n                \"state\": state,\n                \"ready\": ready,\n            }\n        )\n    tooling_tally: dict = {}\n    for node in nodes:\n        if node[\"family\"] == \"R/O\":\n            tooling_tally[node[\"status\"]] = tooling_tally.get(node[\"status\"], 0) + 1\n    return {\n        \"schema_version\": 1,\n        \"sources\": {\"tickets\": str(TICKETS_CANONICAL), \"stage_status\": str(STAGE_CANONICAL)},\n        \"execution_control\": {\n            \"tickets_status\": tickets_ec[\"status\"],\n            \"stage_status_status\": stage_ec[\"status\"],\n            \"start_next_ticket\": {\n                \"tickets\": tickets_ec[\"start_next_ticket\"],\n                \"stage_status\": stage_ec[\"start_next_ticket\"],\n            },\n            \"paused\": paused,\n        },\n        \"counts\": stage_counts,\n        \"tooling_counts\": tooling_tally,\n        \"node_totals\": {\"VN_TX\": len(records), \"RO\": len(tooling_records)},\n        \"ready\": [n[\"task_id\"] for n in nodes if n[\"ready\"]],\n        \"running\": [n[\"task_id\"] for n in nodes if n[\"running\"]],\n        \"external\": [n[\"task_id\"] for n in nodes if n[\"external\"]],\n        \"nodes\": nodes,\n        \"paused\": paused,\n        \"last_completed_ticket\": tickets_ec[\"last_completed_ticket\"],\n        \"last_completed_tooling_ticket\": tickets_ec[\"last_completed_tooling_ticket\"],\n    }\n\n\ndef render_markdown(status: dict, git_head: str) -> str:\n    lines = [\n        \"# Local status projection (v3)\",\n        \"\",\n        f\"Canonical sources: `{status['sources']['tickets']}`, `{status['sources']['stage_status']}`; \"\n        \"`context.json` is a bounded derived summary only.\",\n        f\"Git HEAD: `{git_head}`\",\n        \"\",\n        \"## Execution control\",\n        \"\",\n        f\"- tickets: `{status['execution_control']['tickets_status']}`; start_next_ticket=\"\n        f\"`{status['execution_control']['start_next_ticket']['tickets']}`\",\n        f\"- stage_status: `{status['execution_control']['stage_status_status']}`; start_next_ticket=\"\n        f\"`{status['execution_control']['start_next_ticket']['stage_status']}`\",\n        f\"- dispatch paused: `{status['paused']}`\",\n        \"\",\n        \"## Stage counts (VN/TX)\",\n        \"\",\n    ]\n    for category in sorted(status[\"counts\"]):\n        lines.append(f\"- {category}: {status['counts'][category]}\")\n    tooling = \", \".join(f\"{name} {value}\" for name, value in sorted(status[\"tooling_counts\"].items())) or \"none\"\n    lines += [\n        f\"- tooling (R/O): {tooling}\",\n        f\"- originals plus tooling: {status['node_totals']['VN_TX']} VN/TX nodes, \"\n        f\"{status['node_totals']['RO']} R/O nodes\",\n        \"\",\n        \"## Progress\",\n        \"\",\n        f\"- last completed ticket: `{status['last_completed_ticket']}`; last completed tooling \"\n        f\"ticket: `{status['last_completed_tooling_ticket']}`\",\n        f\"- running (no duplicate dispatch): {', '.join(f'`{x}`' for x in status['running']) or 'none'}\",\n        f\"- ready now (dispatch unlocked): {', '.join(f'`{x}`' for x in status['ready']) or 'none'}\",\n        f\"- external (never auto-run): {', '.join(f'`{x}`' for x in status['external']) or 'none'}\",\n        \"\",\n        \"Local/operational distinction: `COMPLETE_LOCAL_IMPLEMENTATION` marks local implementation\",\n        \"acceptance only; production, deploy and long-duration resource gates remain open. The\",\n        \"canonical record keeps the original VN/TX status strings, e.g. VN07 stays `INCOMPLETE` and\",\n        \"VN20 actual cutover/deletion is EXTERNAL and is never executed automatically.\",\n        \"\",\n    ]\n    return \"\\n\".join(lines)\n\n\ndef _git_head(root: Path) -> str:\n    \"\"\"Record the current Git HEAD; when unavailable, UNKNOWN is explicit.\"\"\"\n    try:\n        completed = subprocess.run(\n            [\"git\", \"rev-parse\", \"HEAD\"], cwd=str(root), capture_output=True, text=True, timeout=10\n        )\n    except (OSError, subprocess.SubprocessError):\n        return \"UNKNOWN\"\n    if completed.returncode != 0:\n        return \"UNKNOWN\"\n    return completed.stdout.strip() or \"UNKNOWN\"\n\n\ndef main(argv=None) -> int:\n    parser = argparse.ArgumentParser(description=\"Read-only v3 status projection (stdlib only).\")\n    parser.add_argument(\"--root\", default=\".\", help=\"repository root to read canonical JSON from\")\n    parser.add_argument(\"--json\", action=\"store_true\", help=\"emit JSON projection (default)\")\n    parser.add_argument(\"--markdown\", action=\"store_true\", help=\"render concise markdown status\")\n    args = parser.parse_args(argv)\n    try:\n        status = load_status(Path(args.root))\n    except ValueError as exc:\n        print(f\"status error: {exc}\", file=sys.stderr)\n        return 2\n    git_head = _git_head(Path(args.root))\n    if args.markdown:\n        print(render_markdown(status, git_head), end=\"\")\n    else:\n        status[\"git_head\"] = git_head\n        print(json.dumps(status, ensure_ascii=False, indent=2))\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())","lineStart":1,"lineEnd":347,"totalLines":347,"truncated":false}},"title":"scripts/dev/status.py","time":{"start":1792688334850,"end":1792688335007}},"id":"prt_1648d27b4001t6Pj3ompPAB8q2","sessionID":"ses_e9b72e4cfffeS6mdRRcprZsE5d","messageID":"msg_1648d1d88001cbiIxMwkEtw7SH"}}
{"type":"tool_use","timestamp":1792688335131,"sessionID":"ses_e9b72e4cfffeS6mdRRcprZsE5d","part":{"type":"tool","tool":"read","callID":"call_01_hjrel0fa73cmf3kiz5y3rav9","state":{"status":"completed","input":{"filePath":"/work/tests/refactoring/test_dev_status.py"},"output":"<path>/work/tests/refactoring/test_dev_status.py</path>\n<type>file</type>\n<content>\n1: \"\"\"R01 acceptance tests: deterministic read-only status projection.\"\"\"\n2: \n3: import importlib.util\n4: import json\n5: import subprocess\n6: import sys\n7: from pathlib import Path\n8: \n9: REPO_ROOT = Path(__file__).resolve().parents[2]\n10: STATUS_SCRIPT = REPO_ROOT / \"scripts\" / \"dev\" / \"status.py\"\n11: \n12: spec = importlib.util.spec_from_file_location(\"dev_status\", STATUS_SCRIPT)\n13: dev_status = importlib.util.module_from_spec(spec)\n14: spec.loader.exec_module(dev_status)\n15: \n16: ACTIVE = \"RUNNING_LOCAL_REFACTORING\"\n17: STOPPED = \"STOPPED_AT_USER_REQUEST\"\n18: \n19: TICKETS_DIR = \"docs/refactoring/vnext\"\n20: \n21: \n22: def _write_canonical(root: Path, tickets: dict, stage: dict) -> None:\n23:     directory = root / TICKETS_DIR\n24:     directory.mkdir(parents=True, exist_ok=True)\n25:     (directory / \"tickets_production.json\").write_text(json.dumps(tickets), encoding=\"utf-8\")\n26:     (directory / \"stage_status.json\").write_text(json.dumps(stage), encoding=\"utf-8\")\n27: \n28: \n29: def _execution_control(status=ACTIVE, start=True, last=\"VN00\", last_tooling=\"R00\"):\n30:     return {\n31:         \"status\": status,\n32:         \"last_completed_ticket\": last,\n33:         \"last_completed_tooling_ticket\": last_tooling,\n34:         \"active_ticket\": None,\n35:         \"start_next_ticket\": start,\n36:         \"stop_after_ticket\": None,\n37:         \"server_deploy_authorized\": False,\n38:         \"live_mutation_authorized\": False,\n39:     }\n40: \n41: \n42: def _ticket(task_id, status, deps, classification):\n43:     return {\n44:         \"task_id\": task_id,\n45:         \"existing_phase\": None,\n46:         \"status\": status,\n47:         \"depends_on\": deps,\n48:         \"baseline\": {\"head\": \"0\" * 40},\n49:         \"stage_classification\": classification,\n50:     }\n51: \n52: \n53: def _tooling_ticket(task_id, status, deps):\n54:     return {\"task_id\": task_id, \"status\": status, \"depends_on\": deps, \"scope\": \"LOCAL_ONLY\", \"receipt\": None}\n55: \n56: \n57: def _stage_task(task_id, category):\n58:     return {\"task_id\": task_id, \"category\": category}\n59: \n60: \n61: def _canonical(\n62:     tasks,\n63:     tooling=(),\n64:     stage_tasks=None,\n65:     counts=None,\n66:     execution_control=None,\n67:     stage_control=None,\n68:     last=\"VN00\",\n69:     last_tooling=\"R00\",\n70: ):\n71:     ec = execution_control or _execution_control(last=last, last_tooling=last_tooling)\n72:     stage_ec = stage_control or _execution_control(last=last, last_tooling=last_tooling)\n73:     if stage_tasks is None:\n74:         stage_tasks = [\n75:             _stage_task(t[\"task_id\"], t[\"stage_classification\"]) for t in tasks\n76:         ]\n77:     if counts is None:\n78:         counts = {}\n79:         for st in stage_tasks:\n80:             counts[st[\"category\"]] = counts.get(st[\"category\"], 0) + 1\n81:     tickets = {\n82:         \"schema_version\": 1,\n83:         \"tasks\": tasks,\n84:         \"tooling_tasks\": list(tooling),\n85:         \"execution_control\": ec,\n86:     }\n87:     stage = {\n88:         \"schema_version\": 1,\n89:         \"counts\": counts,\n90:         \"tasks\": stage_tasks,\n91:         \"execution_control\": stage_ec,\n92:     }\n93:     return tickets, stage\n94: \n95: \n96: def _simple_canonical(tooling=(), **overrides):\n97:     tasks = [\n98:         _ticket(\"VN00\", \"COMPLETE_CURRENT_READ_ONLY_BASELINE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n99:         _ticket(\"VN01\", \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\", [\"VN00\"], \"NOT_STARTED\"),\n100:         _ticket(\"VN20\", \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\", [\"VN01\"], \"NOT_STARTED\"),\n101:     ]\n102:     tickets, stage = _canonical(tasks, tooling, **overrides)\n103:     stage[\"tasks\"] = stage[\"tasks\"][:2] + [_stage_task(\"VN20\", \"NOT_STARTED\")]\n104:     return tickets, stage\n105: \n106: \n107: def test_ready_dependency_satisfaction(tmp_path):\n108:     tickets, stage = _simple_canonical()\n109:     _write_canonical(tmp_path, tickets, stage)\n110:     status = dev_status.load_status(tmp_path)\n111:     node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN01\"]\n112:     assert node[\"ready\"] is True\n113:     assert node[\"state\"] == \"READY\"\n114:     assert node[\"missing_dependencies\"] == []\n115:     assert status[\"ready\"] == [\"VN01\"]\n116:     assert status[\"paused\"] is False\n117: \n118: \n119: def test_false_predecessor_not_accepted(tmp_path):\n120:     tasks = [\n121:         _ticket(\"VN00\", \"PARTIAL_DONE_STATUS\", [], \"INCOMPLETE\"),\n122:         _ticket(\"VN01\", \"PLANNED\", [\"VN00\"], \"NOT_STARTED\"),\n123:     ]\n124:     tickets, stage = _canonical(tasks)\n125:     _write_canonical(tmp_path, tickets, stage)\n126:     status = dev_status.load_status(tmp_path)\n127:     node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN01\"]\n128:     assert node[\"ready\"] is False\n129:     assert node[\"state\"] == \"BLOCKED\"\n130:     assert node[\"missing_dependencies\"] == [\"VN00\"]\n131:     assert status[\"ready\"] == [\"VN00\"]\n132: \n133: \n134: def test_duplicate_id_refused(tmp_path):\n135:     tasks = [\n136:         _ticket(\"VN00\", \"DONE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n137:         _ticket(\"VN00\", \"DONE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n138:     ]\n139:     tickets, stage = _canonical(tasks)\n140:     stage[\"tasks\"] = [_stage_task(\"VN00\", \"COMPLETE_LOCAL_IMPLEMENTATION\")]\n141:     _write_canonical(tmp_path, tickets, stage)\n142:     try:\n143:         dev_status.load_status(tmp_path)\n144:     except ValueError as exc:\n145:         assert \"duplicate task_id\" in str(exc)\n146:     else:\n147:         raise AssertionError(\"duplicate id accepted\")\n148: \n149: \n150: def test_dangling_dependency_refused(tmp_path):\n151:     tasks = [_ticket(\"VN01\", \"PLANNED\", [\"VNMISSING\"], \"NOT_STARTED\")]\n152:     tickets, stage = _canonical(tasks)\n153:     _write_canonical(tmp_path, tickets, stage)\n154:     try:\n155:         dev_status.load_status(tmp_path)\n156:     except ValueError as exc:\n157:         assert \"unknown id\" in str(exc)\n158:     else:\n159:         raise AssertionError(\"dangling dependency accepted\")\n160: \n161: \n162: def test_cycle_refused(tmp_path):\n163:     tasks = [\n164:         _ticket(\"A\", \"PLANNED\", [\"B\"], \"NOT_STARTED\"),\n165:         _ticket(\"B\", \"PLANNED\", [\"A\"], \"NOT_STARTED\"),\n166:     ]\n167:     tickets, stage = _canonical(tasks)\n168:     _write_canonical(tmp_path, tickets, stage)\n169:     try:\n170:         dev_status.load_status(tmp_path)\n171:     except ValueError as exc:\n172:         assert \"cycle\" in str(exc)\n173:     else:\n174:         raise AssertionError(\"cycle accepted\")\n175: \n176: \n177: def test_stage_count_mismatch_refused(tmp_path):\n178:     tickets, stage = _simple_canonical()\n179:     stage[\"counts\"][\"NOT_STARTED\"] = 99\n180:     _write_canonical(tmp_path, tickets, stage)\n181:     try:\n182:         dev_status.load_status(tmp_path)\n183:     except ValueError as exc:\n184:         assert \"stage count mismatch\" in str(exc)\n185:     else:\n186:         raise AssertionError(\"count mismatch accepted\")\n187: \n188: \n189: def test_paused_execution_blocks_dispatch(tmp_path):\n190:     tickets, stage = _simple_canonical(\n191:         execution_control=_execution_control(status=STOPPED),\n192:         stage_control=_execution_control(status=STOPPED),\n193:     )\n194:     _write_canonical(tmp_path, tickets, stage)\n195:     status = dev_status.load_status(tmp_path)\n196:     assert status[\"paused\"] is True\n197:     assert status[\"ready\"] == []\n198:     node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN01\"]\n199:     assert node[\"ready\"] is False\n200:     assert node[\"state\"] == \"PAUSED_DISPATCH\"\n201: \n202: \n203: def test_start_next_ticket_false_blocks_dispatch(tmp_path):\n204:     tickets, stage = _simple_canonical(\n205:         execution_control=_execution_control(start=False),\n206:         stage_control=_execution_control(start=False),\n207:     )\n208:     _write_canonical(tmp_path, tickets, stage)\n209:     status = dev_status.load_status(tmp_path)\n210:     assert status[\"ready\"] == []\n211:     assert status[\"execution_control\"][\"start_next_ticket\"][\"tickets\"] is False\n212: \n213: \n214: def test_running_not_ready(tmp_path):\n215:     tickets, stage = _simple_canonical(\n216:         tooling=[_tooling_ticket(\"O00\", \"RUNNING\", [\"VN00\"]), _tooling_ticket(\"R00\", \"ACCEPTED\", [])],\n217:     )\n218:     _write_canonical(tmp_path, tickets, stage)\n219:     status = dev_status.load_status(tmp_path)\n220:     node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"O00\"]\n221:     assert node[\"running\"] is True\n222:     assert node[\"state\"] == \"RUNNING\"\n223:     assert node[\"ready\"] is False\n224:     assert status[\"running\"] == [\"O00\"]\n225:     assert status[\"ready\"] == [\"VN01\"]\n226:     tooling = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"R00\"]\n227:     assert tooling[\"complete\"] is True\n228:     assert tooling[\"state\"] == \"COMPLETE\"\n229: \n230: \n231: def test_vn20_external(tmp_path):\n232:     tasks = [\n233:         _ticket(\"VN00\", \"COMPLETE_CURRENT_READ_ONLY_BASELINE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n234:         _ticket(\"VN19\", \"COMPLETE_REVIEW_PACKAGE_PREPARED\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n235:         _ticket(\"VN20\", \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\", [\"VN19\"], \"NOT_STARTED\"),\n236:     ]\n237:     stage_tasks = [\n238:         _stage_task(\"VN00\", \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n239:         _stage_task(\"VN19\", \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n240:         _stage_task(\"VN20\", \"NOT_STARTED\"),\n241:     ]\n242:     tickets, stage = _canonical(tasks, stage_tasks=stage_tasks)\n243:     _write_canonical(tmp_path, tickets, stage)\n244:     status = dev_status.load_status(tmp_path)\n245:     node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN20\"]\n246:     assert node[\"external\"] is True\n247:     assert node[\"ready\"] is False\n248:     assert node[\"state\"] == \"EXTERNAL\"\n249:     assert node[\"stage\"] == \"NOT_STARTED\"\n250:     assert node[\"status\"] == \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\"\n251:     assert node[\"missing_dependencies\"] == []\n252:     assert \"VN20\" in status[\"external\"]\n253: \n254: \n255: def test_ro_union_without_changing_vn_tx_counts(tmp_path):\n256:     tooling = [\n257:         _tooling_ticket(\"R00\", \"ACCEPTED\", []),\n258:         _tooling_ticket(\"R01\", \"PLANNED\", [\"R00\"]),\n259:         _tooling_ticket(\"O00\", \"RUNNING\", [\"R00\"]),\n260:         _tooling_ticket(\"O01\", \"PLANNED\", [\"R01\", \"O00\"]),\n261:     ]\n262:     tickets, stage = _simple_canonical(tooling=tooling)\n263:     _write_canonical(tmp_path, tickets, stage)\n264:     status = dev_status.load_status(tmp_path)\n265:     assert status[\"node_totals\"][\"VN_TX\"] == 3\n266:     assert status[\"node_totals\"][\"RO\"] == 4\n267:     for category, value in status[\"counts\"].items():\n268:         assert value == stage[\"counts\"][category]\n269:     assert status[\"tooling_counts\"] == {\"ACCEPTED\": 1, \"PLANNED\": 2, \"RUNNING\": 1}\n270:     o01 = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"O01\"]\n271:     assert o01[\"state\"] == \"BLOCKED\"\n272:     assert sorted(o01[\"missing_dependencies\"]) == [\"O00\", \"R01\"]\n273:     assert status[\"ready\"] == [\"VN01\", \"R01\"]\n274: \n275: \n276: def test_last_completed_ticket_conflict_refused(tmp_path):\n277:     tickets, stage = _simple_canonical(\n278:         stage_control=_execution_control(last=\"VN99\"),\n279:     )\n280:     _write_canonical(tmp_path, tickets, stage)\n281:     try:\n282:         dev_status.load_status(tmp_path)\n283:     except ValueError as exc:\n284:         assert \"conflict\" in str(exc)\n285:     else:\n286:         raise AssertionError(\"conflicting completion records accepted\")\n287: \n288: \n289: def test_real_copied_canonical_cli(tmp_path):\n290:     canonical = REPO_ROOT / TICKETS_DIR\n291:     directory = tmp_path / TICKETS_DIR\n292:     directory.mkdir(parents=True)\n293:     for name in (\"tickets_production.json\", \"stage_status.json\"):\n294:         source = canonical / name\n295:         assert source.is_file(), f\"missing real canonical file: {source}\"\n296:         (directory / name).write_bytes(source.read_bytes())\n297:     status = dev_status.load_status(tmp_path)\n298:     assert status[\"node_totals\"][\"VN_TX\"] == 51\n299:     assert status[\"node_totals\"][\"RO\"] == 9\n300:     assert len(status[\"nodes\"]) == 60\n301:     assert status[\"counts\"] == {\n302:         \"COMPLETE_LOCAL_IMPLEMENTATION\": 14,\n303:         \"INCOMPLETE\": 23,\n304:         \"NOT_STARTED\": 14,\n305:     }\n306:     for node in status[\"nodes\"]:\n307:         if node[\"family\"] == \"VN/TX\":\n308:             assert node[\"stage\"] in {\"COMPLETE_LOCAL_IMPLEMENTATION\", \"INCOMPLETE\", \"NOT_STARTED\"}\n309:     completed = [n for n in status[\"nodes\"] if n[\"complete\"]]\n310:     assert len(completed) == 15\n311:     assert {n[\"task_id\"] for n in completed if n[\"family\"] == \"VN/TX\"} == {\n312:         \"VN00\", \"VN01\", \"VN02\", \"VN03\", \"VN04A\", \"VN04B\", \"VN05\", \"VN06\",\n313:         \"VN10\", \"VN11\", \"VN12\", \"VN14A\", \"VN14B\", \"VN16\",\n314:     }\n315:     assert {n[\"task_id\"] for n in completed if n[\"family\"] == \"R/O\"} == {\"R00\"}\n316:     assert status[\"last_completed_ticket\"] == \"VN14B\"\n317:     assert status[\"last_completed_tooling_ticket\"] == \"R00\"\n318:     assert {n[\"task_id\"] for n in completed if n[\"family\"] == \"R/O\"} == {\"R00\"}\n319:     assert status[\"ready\"] == [\"VN07\", \"TX00\", \"R01\"]\n320:     running = {n[\"task_id\"] for n in status[\"running\"]}\n321:     assert running == {\"O00\"}\n322:     vn20 = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN20\"]\n323:     assert vn20[\"state\"] == \"EXTERNAL\" and vn20[\"ready\"] is False\n324: \n325:     result = subprocess.run(\n326:         [sys.executable, str(STATUS_SCRIPT), \"--root\", str(tmp_path), \"--json\"],\n327:         capture_output=True,\n328:         text=True,\n329:         timeout=30,\n330:     )\n331:     assert result.returncode == 0, result.stderr\n332:     projection = json.loads(result.stdout)\n333:     assert projection[\"node_totals\"] == {\"VN_TX\": 51, \"RO\": 9}\n\n(End of file - total 333 lines)\n</content>","metadata":{"preview":"\"\"\"R01 acceptance tests: deterministic read-only status projection.\"\"\"\n\nimport importlib.util\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\nSTATUS_SCRIPT = REPO_ROOT / \"scripts\" / \"dev\" / \"status.py\"\n\nspec = importlib.util.spec_from_file_location(\"dev_status\", STATUS_SCRIPT)\ndev_status = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(dev_status)\n\nACTIVE = \"RUNNING_LOCAL_REFACTORING\"\nSTOPPED = \"STOPPED_AT_USER_REQUEST\"\n\nTICKETS_DIR = \"docs/refactoring/vnext\"\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/work/tests/refactoring/test_dev_status.py","text":"\"\"\"R01 acceptance tests: deterministic read-only status projection.\"\"\"\n\nimport importlib.util\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\nSTATUS_SCRIPT = REPO_ROOT / \"scripts\" / \"dev\" / \"status.py\"\n\nspec = importlib.util.spec_from_file_location(\"dev_status\", STATUS_SCRIPT)\ndev_status = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(dev_status)\n\nACTIVE = \"RUNNING_LOCAL_REFACTORING\"\nSTOPPED = \"STOPPED_AT_USER_REQUEST\"\n\nTICKETS_DIR = \"docs/refactoring/vnext\"\n\n\ndef _write_canonical(root: Path, tickets: dict, stage: dict) -> None:\n    directory = root / TICKETS_DIR\n    directory.mkdir(parents=True, exist_ok=True)\n    (directory / \"tickets_production.json\").write_text(json.dumps(tickets), encoding=\"utf-8\")\n    (directory / \"stage_status.json\").write_text(json.dumps(stage), encoding=\"utf-8\")\n\n\ndef _execution_control(status=ACTIVE, start=True, last=\"VN00\", last_tooling=\"R00\"):\n    return {\n        \"status\": status,\n        \"last_completed_ticket\": last,\n        \"last_completed_tooling_ticket\": last_tooling,\n        \"active_ticket\": None,\n        \"start_next_ticket\": start,\n        \"stop_after_ticket\": None,\n        \"server_deploy_authorized\": False,\n        \"live_mutation_authorized\": False,\n    }\n\n\ndef _ticket(task_id, status, deps, classification):\n    return {\n        \"task_id\": task_id,\n        \"existing_phase\": None,\n        \"status\": status,\n        \"depends_on\": deps,\n        \"baseline\": {\"head\": \"0\" * 40},\n        \"stage_classification\": classification,\n    }\n\n\ndef _tooling_ticket(task_id, status, deps):\n    return {\"task_id\": task_id, \"status\": status, \"depends_on\": deps, \"scope\": \"LOCAL_ONLY\", \"receipt\": None}\n\n\ndef _stage_task(task_id, category):\n    return {\"task_id\": task_id, \"category\": category}\n\n\ndef _canonical(\n    tasks,\n    tooling=(),\n    stage_tasks=None,\n    counts=None,\n    execution_control=None,\n    stage_control=None,\n    last=\"VN00\",\n    last_tooling=\"R00\",\n):\n    ec = execution_control or _execution_control(last=last, last_tooling=last_tooling)\n    stage_ec = stage_control or _execution_control(last=last, last_tooling=last_tooling)\n    if stage_tasks is None:\n        stage_tasks = [\n            _stage_task(t[\"task_id\"], t[\"stage_classification\"]) for t in tasks\n        ]\n    if counts is None:\n        counts = {}\n        for st in stage_tasks:\n            counts[st[\"category\"]] = counts.get(st[\"category\"], 0) + 1\n    tickets = {\n        \"schema_version\": 1,\n        \"tasks\": tasks,\n        \"tooling_tasks\": list(tooling),\n        \"execution_control\": ec,\n    }\n    stage = {\n        \"schema_version\": 1,\n        \"counts\": counts,\n        \"tasks\": stage_tasks,\n        \"execution_control\": stage_ec,\n    }\n    return tickets, stage\n\n\ndef _simple_canonical(tooling=(), **overrides):\n    tasks = [\n        _ticket(\"VN00\", \"COMPLETE_CURRENT_READ_ONLY_BASELINE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n        _ticket(\"VN01\", \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\", [\"VN00\"], \"NOT_STARTED\"),\n        _ticket(\"VN20\", \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\", [\"VN01\"], \"NOT_STARTED\"),\n    ]\n    tickets, stage = _canonical(tasks, tooling, **overrides)\n    stage[\"tasks\"] = stage[\"tasks\"][:2] + [_stage_task(\"VN20\", \"NOT_STARTED\")]\n    return tickets, stage\n\n\ndef test_ready_dependency_satisfaction(tmp_path):\n    tickets, stage = _simple_canonical()\n    _write_canonical(tmp_path, tickets, stage)\n    status = dev_status.load_status(tmp_path)\n    node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN01\"]\n    assert node[\"ready\"] is True\n    assert node[\"state\"] == \"READY\"\n    assert node[\"missing_dependencies\"] == []\n    assert status[\"ready\"] == [\"VN01\"]\n    assert status[\"paused\"] is False\n\n\ndef test_false_predecessor_not_accepted(tmp_path):\n    tasks = [\n        _ticket(\"VN00\", \"PARTIAL_DONE_STATUS\", [], \"INCOMPLETE\"),\n        _ticket(\"VN01\", \"PLANNED\", [\"VN00\"], \"NOT_STARTED\"),\n    ]\n    tickets, stage = _canonical(tasks)\n    _write_canonical(tmp_path, tickets, stage)\n    status = dev_status.load_status(tmp_path)\n    node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN01\"]\n    assert node[\"ready\"] is False\n    assert node[\"state\"] == \"BLOCKED\"\n    assert node[\"missing_dependencies\"] == [\"VN00\"]\n    assert status[\"ready\"] == [\"VN00\"]\n\n\ndef test_duplicate_id_refused(tmp_path):\n    tasks = [\n        _ticket(\"VN00\", \"DONE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n        _ticket(\"VN00\", \"DONE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n    ]\n    tickets, stage = _canonical(tasks)\n    stage[\"tasks\"] = [_stage_task(\"VN00\", \"COMPLETE_LOCAL_IMPLEMENTATION\")]\n    _write_canonical(tmp_path, tickets, stage)\n    try:\n        dev_status.load_status(tmp_path)\n    except ValueError as exc:\n        assert \"duplicate task_id\" in str(exc)\n    else:\n        raise AssertionError(\"duplicate id accepted\")\n\n\ndef test_dangling_dependency_refused(tmp_path):\n    tasks = [_ticket(\"VN01\", \"PLANNED\", [\"VNMISSING\"], \"NOT_STARTED\")]\n    tickets, stage = _canonical(tasks)\n    _write_canonical(tmp_path, tickets, stage)\n    try:\n        dev_status.load_status(tmp_path)\n    except ValueError as exc:\n        assert \"unknown id\" in str(exc)\n    else:\n        raise AssertionError(\"dangling dependency accepted\")\n\n\ndef test_cycle_refused(tmp_path):\n    tasks = [\n        _ticket(\"A\", \"PLANNED\", [\"B\"], \"NOT_STARTED\"),\n        _ticket(\"B\", \"PLANNED\", [\"A\"], \"NOT_STARTED\"),\n    ]\n    tickets, stage = _canonical(tasks)\n    _write_canonical(tmp_path, tickets, stage)\n    try:\n        dev_status.load_status(tmp_path)\n    except ValueError as exc:\n        assert \"cycle\" in str(exc)\n    else:\n        raise AssertionError(\"cycle accepted\")\n\n\ndef test_stage_count_mismatch_refused(tmp_path):\n    tickets, stage = _simple_canonical()\n    stage[\"counts\"][\"NOT_STARTED\"] = 99\n    _write_canonical(tmp_path, tickets, stage)\n    try:\n        dev_status.load_status(tmp_path)\n    except ValueError as exc:\n        assert \"stage count mismatch\" in str(exc)\n    else:\n        raise AssertionError(\"count mismatch accepted\")\n\n\ndef test_paused_execution_blocks_dispatch(tmp_path):\n    tickets, stage = _simple_canonical(\n        execution_control=_execution_control(status=STOPPED),\n        stage_control=_execution_control(status=STOPPED),\n    )\n    _write_canonical(tmp_path, tickets, stage)\n    status = dev_status.load_status(tmp_path)\n    assert status[\"paused\"] is True\n    assert status[\"ready\"] == []\n    node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN01\"]\n    assert node[\"ready\"] is False\n    assert node[\"state\"] == \"PAUSED_DISPATCH\"\n\n\ndef test_start_next_ticket_false_blocks_dispatch(tmp_path):\n    tickets, stage = _simple_canonical(\n        execution_control=_execution_control(start=False),\n        stage_control=_execution_control(start=False),\n    )\n    _write_canonical(tmp_path, tickets, stage)\n    status = dev_status.load_status(tmp_path)\n    assert status[\"ready\"] == []\n    assert status[\"execution_control\"][\"start_next_ticket\"][\"tickets\"] is False\n\n\ndef test_running_not_ready(tmp_path):\n    tickets, stage = _simple_canonical(\n        tooling=[_tooling_ticket(\"O00\", \"RUNNING\", [\"VN00\"]), _tooling_ticket(\"R00\", \"ACCEPTED\", [])],\n    )\n    _write_canonical(tmp_path, tickets, stage)\n    status = dev_status.load_status(tmp_path)\n    node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"O00\"]\n    assert node[\"running\"] is True\n    assert node[\"state\"] == \"RUNNING\"\n    assert node[\"ready\"] is False\n    assert status[\"running\"] == [\"O00\"]\n    assert status[\"ready\"] == [\"VN01\"]\n    tooling = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"R00\"]\n    assert tooling[\"complete\"] is True\n    assert tooling[\"state\"] == \"COMPLETE\"\n\n\ndef test_vn20_external(tmp_path):\n    tasks = [\n        _ticket(\"VN00\", \"COMPLETE_CURRENT_READ_ONLY_BASELINE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n        _ticket(\"VN19\", \"COMPLETE_REVIEW_PACKAGE_PREPARED\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n        _ticket(\"VN20\", \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\", [\"VN19\"], \"NOT_STARTED\"),\n    ]\n    stage_tasks = [\n        _stage_task(\"VN00\", \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n        _stage_task(\"VN19\", \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n        _stage_task(\"VN20\", \"NOT_STARTED\"),\n    ]\n    tickets, stage = _canonical(tasks, stage_tasks=stage_tasks)\n    _write_canonical(tmp_path, tickets, stage)\n    status = dev_status.load_status(tmp_path)\n    node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN20\"]\n    assert node[\"external\"] is True\n    assert node[\"ready\"] is False\n    assert node[\"state\"] == \"EXTERNAL\"\n    assert node[\"stage\"] == \"NOT_STARTED\"\n    assert node[\"status\"] == \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\"\n    assert node[\"missing_dependencies\"] == []\n    assert \"VN20\" in status[\"external\"]\n\n\ndef test_ro_union_without_changing_vn_tx_counts(tmp_path):\n    tooling = [\n        _tooling_ticket(\"R00\", \"ACCEPTED\", []),\n        _tooling_ticket(\"R01\", \"PLANNED\", [\"R00\"]),\n        _tooling_ticket(\"O00\", \"RUNNING\", [\"R00\"]),\n        _tooling_ticket(\"O01\", \"PLANNED\", [\"R01\", \"O00\"]),\n    ]\n    tickets, stage = _simple_canonical(tooling=tooling)\n    _write_canonical(tmp_path, tickets, stage)\n    status = dev_status.load_status(tmp_path)\n    assert status[\"node_totals\"][\"VN_TX\"] == 3\n    assert status[\"node_totals\"][\"RO\"] == 4\n    for category, value in status[\"counts\"].items():\n        assert value == stage[\"counts\"][category]\n    assert status[\"tooling_counts\"] == {\"ACCEPTED\": 1, \"PLANNED\": 2, \"RUNNING\": 1}\n    o01 = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"O01\"]\n    assert o01[\"state\"] == \"BLOCKED\"\n    assert sorted(o01[\"missing_dependencies\"]) == [\"O00\", \"R01\"]\n    assert status[\"ready\"] == [\"VN01\", \"R01\"]\n\n\ndef test_last_completed_ticket_conflict_refused(tmp_path):\n    tickets, stage = _simple_canonical(\n        stage_control=_execution_control(last=\"VN99\"),\n    )\n    _write_canonical(tmp_path, tickets, stage)\n    try:\n        dev_status.load_status(tmp_path)\n    except ValueError as exc:\n        assert \"conflict\" in str(exc)\n    else:\n        raise AssertionError(\"conflicting completion records accepted\")\n\n\ndef test_real_copied_canonical_cli(tmp_path):\n    canonical = REPO_ROOT / TICKETS_DIR\n    directory = tmp_path / TICKETS_DIR\n    directory.mkdir(parents=True)\n    for name in (\"tickets_production.json\", \"stage_status.json\"):\n        source = canonical / name\n        assert source.is_file(), f\"missing real canonical file: {source}\"\n        (directory / name).write_bytes(source.read_bytes())\n    status = dev_status.load_status(tmp_path)\n    assert status[\"node_totals\"][\"VN_TX\"] == 51\n    assert status[\"node_totals\"][\"RO\"] == 9\n    assert len(status[\"nodes\"]) == 60\n    assert status[\"counts\"] == {\n        \"COMPLETE_LOCAL_IMPLEMENTATION\": 14,\n        \"INCOMPLETE\": 23,\n        \"NOT_STARTED\": 14,\n    }\n    for node in status[\"nodes\"]:\n        if node[\"family\"] == \"VN/TX\":\n            assert node[\"stage\"] in {\"COMPLETE_LOCAL_IMPLEMENTATION\", \"INCOMPLETE\", \"NOT_STARTED\"}\n    completed = [n for n in status[\"nodes\"] if n[\"complete\"]]\n    assert len(completed) == 15\n    assert {n[\"task_id\"] for n in completed if n[\"family\"] == \"VN/TX\"} == {\n        \"VN00\", \"VN01\", \"VN02\", \"VN03\", \"VN04A\", \"VN04B\", \"VN05\", \"VN06\",\n        \"VN10\", \"VN11\", \"VN12\", \"VN14A\", \"VN14B\", \"VN16\",\n    }\n    assert {n[\"task_id\"] for n in completed if n[\"family\"] == \"R/O\"} == {\"R00\"}\n    assert status[\"last_completed_ticket\"] == \"VN14B\"\n    assert status[\"last_completed_tooling_ticket\"] == \"R00\"\n    assert {n[\"task_id\"] for n in completed if n[\"family\"] == \"R/O\"} == {\"R00\"}\n    assert status[\"ready\"] == [\"VN07\", \"TX00\", \"R01\"]\n    running = {n[\"task_id\"] for n in status[\"running\"]}\n    assert running == {\"O00\"}\n    vn20 = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN20\"]\n    assert vn20[\"state\"] == \"EXTERNAL\" and vn20[\"ready\"] is False\n\n    result = subprocess.run(\n        [sys.executable, str(STATUS_SCRIPT), \"--root\", str(tmp_path), \"--json\"],\n        capture_output=True,\n        text=True,\n        timeout=30,\n    )\n    assert result.returncode == 0, result.stderr\n    projection = json.loads(result.stdout)\n    assert projection[\"node_totals\"] == {\"VN_TX\": 51, \"RO\": 9}","lineStart":1,"lineEnd":333,"totalLines":333,"truncated":false}},"title":"tests/refactoring/test_dev_status.py","time":{"start":1792688334968,"end":1792688335111}},"id":"prt_1648d2808001vd4WQ5fPTDsL64","sessionID":"ses_e9b72e4cfffeS6mdRRcprZsE5d","messageID":"msg_1648d1d88001cbiIxMwkEtw7SH"}}
