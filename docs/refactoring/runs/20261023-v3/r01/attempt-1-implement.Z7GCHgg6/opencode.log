{"type":"tool_use","timestamp":1792687897838,"sessionID":"ses_e9b79d248ffe6pD2GFdVT2YUYs","part":{"type":"tool","tool":"read","callID":"call_1f598d7e64d141259c7f76ed","state":{"status":"completed","input":{"filePath":"/work/tests/refactoring/test_dev_status.py"},"output":"<path>/work/tests/refactoring/test_dev_status.py</path>\n<type>file</type>\n<content>\n1: \"\"\"R01 acceptance tests: deterministic read-only status projection.\"\"\"\n2: \n3: import importlib.util\n4: import json\n5: import subprocess\n6: import sys\n7: from pathlib import Path\n8: \n9: REPO_ROOT = Path(__file__).resolve().parents[2]\n10: STATUS_SCRIPT = REPO_ROOT / \"scripts\" / \"dev\" / \"status.py\"\n11: \n12: spec = importlib.util.spec_from_file_location(\"dev_status\", STATUS_SCRIPT)\n13: dev_status = importlib.util.module_from_spec(spec)\n14: spec.loader.exec_module(dev_status)\n15: \n16: ACTIVE = \"RUNNING_LOCAL_REFACTORING\"\n17: STOPPED = \"STOPPED_AT_USER_REQUEST\"\n18: \n19: TICKETS_DIR = \"docs/refactoring/vnext\"\n20: \n21: \n22: def _write_canonical(root: Path, tickets: dict, stage: dict) -> None:\n23:     directory = root / TICKETS_DIR\n24:     directory.mkdir(parents=True, exist_ok=True)\n25:     (directory / \"tickets_production.json\").write_text(json.dumps(tickets), encoding=\"utf-8\")\n26:     (directory / \"stage_status.json\").write_text(json.dumps(stage), encoding=\"utf-8\")\n27: \n28: \n29: def _execution_control(status=ACTIVE, start=True, last=\"VN00\", last_tooling=\"R00\"):\n30:     return {\n31:         \"status\": status,\n32:         \"last_completed_ticket\": last,\n33:         \"last_completed_tooling_ticket\": last_tooling,\n34:         \"active_ticket\": None,\n35:         \"start_next_ticket\": start,\n36:         \"stop_after_ticket\": None,\n37:         \"server_deploy_authorized\": False,\n38:         \"live_mutation_authorized\": False,\n39:     }\n40: \n41: \n42: def _ticket(task_id, status, deps, classification):\n43:     return {\n44:         \"task_id\": task_id,\n45:         \"existing_phase\": None,\n46:         \"status\": status,\n47:         \"depends_on\": deps,\n48:         \"baseline\": {\"head\": \"0\" * 40},\n49:         \"stage_classification\": classification,\n50:     }\n51: \n52: \n53: def _tooling_ticket(task_id, status, deps):\n54:     return {\"task_id\": task_id, \"status\": status, \"depends_on\": deps, \"scope\": \"LOCAL_ONLY\", \"receipt\": None}\n55: \n56: \n57: def _stage_task(task_id, category):\n58:     return {\"task_id\": task_id, \"category\": category}\n59: \n60: \n61: def _canonical(\n62:     tasks,\n63:     tooling=(),\n64:     stage_tasks=None,\n65:     counts=None,\n66:     execution_control=None,\n67:     stage_control=None,\n68:     last=\"VN00\",\n69:     last_tooling=\"R00\",\n70: ):\n71:     ec = execution_control or _execution_control(last=last, last_tooling=last_tooling)\n72:     stage_ec = stage_control or _execution_control(last=last, last_tooling=last_tooling)\n73:     if stage_tasks is None:\n74:         stage_tasks = [\n75:             _stage_task(t[\"task_id\"], t[\"stage_classification\"]) for t in tasks\n76:         ]\n77:     if counts is None:\n78:         counts = {}\n79:         for st in stage_tasks:\n80:             counts[st[\"category\"]] = counts.get(st[\"category\"], 0) + 1\n81:     tickets = {\n82:         \"schema_version\": 1,\n83:         \"tasks\": tasks,\n84:         \"tooling_tasks\": list(tooling),\n85:         \"execution_control\": ec,\n86:     }\n87:     stage = {\n88:         \"schema_version\": 1,\n89:         \"counts\": counts,\n90:         \"tasks\": stage_tasks,\n91:         \"execution_control\": stage_ec,\n92:     }\n93:     return tickets, stage\n94: \n95: \n96: def _simple_canonical(tooling=(), **overrides):\n97:     tasks = [\n98:         _ticket(\"VN00\", \"COMPLETE_CURRENT_READ_ONLY_BASELINE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n99:         _ticket(\"VN01\", \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\", [\"VN00\"], \"NOT_STARTED\"),\n100:         _ticket(\"VN20\", \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\", [\"VN01\"], \"NOT_STARTED\"),\n101:     ]\n102:     tickets, stage = _canonical(tasks, tooling, **overrides)\n103:     stage[\"tasks\"] = stage[\"tasks\"][:2] + [_stage_task(\"VN20\", \"NOT_STARTED\")]\n104:     return tickets, stage\n105: \n106: \n107: def test_ready_dependency_satisfaction(tmp_path):\n108:     tickets, stage = _simple_canonical()\n109:     _write_canonical(tmp_path, tickets, stage)\n110:     status = dev_status.load_status(tmp_path)\n111:     node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN01\"]\n112:     assert node[\"ready\"] is True\n113:     assert node[\"state\"] == \"READY\"\n114:     assert node[\"missing_dependencies\"] == []\n115:     assert status[\"ready\"] == [\"VN01\"]\n116:     assert status[\"paused\"] is False\n117: \n118: \n119: def test_false_predecessor_not_accepted(tmp_path):\n120:     tasks = [\n121:         _ticket(\"VN00\", \"PARTIAL_DONE_STATUS\", [], \"INCOMPLETE\"),\n122:         _ticket(\"VN01\", \"PLANNED\", [\"VN00\"], \"NOT_STARTED\"),\n123:     ]\n124:     tickets, stage = _canonical(tasks)\n125:     _write_canonical(tmp_path, tickets, stage)\n126:     status = dev_status.load_status(tmp_path)\n127:     node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN01\"]\n128:     assert node[\"ready\"] is False\n129:     assert node[\"state\"] == \"BLOCKED\"\n130:     assert node[\"missing_dependencies\"] == [\"VN00\"]\n131:     assert status[\"ready\"] == [\"VN00\"]\n132: \n133: \n134: def test_duplicate_id_refused(tmp_path):\n135:     tasks = [\n136:         _ticket(\"VN00\", \"DONE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n137:         _ticket(\"VN00\", \"DONE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n138:     ]\n139:     tickets, stage = _canonical(tasks)\n140:     stage[\"tasks\"] = [_stage_task(\"VN00\", \"COMPLETE_LOCAL_IMPLEMENTATION\")]\n141:     _write_canonical(tmp_path, tickets, stage)\n142:     try:\n143:         dev_status.load_status(tmp_path)\n144:     except ValueError as exc:\n145:         assert \"duplicate task_id\" in str(exc)\n146:     else:\n147:         raise AssertionError(\"duplicate id accepted\")\n148: \n149: \n150: def test_dangling_dependency_refused(tmp_path):\n151:     tasks = [_ticket(\"VN01\", \"PLANNED\", [\"VNMISSING\"], \"NOT_STARTED\")]\n152:     tickets, stage = _canonical(tasks)\n153:     _write_canonical(tmp_path, tickets, stage)\n154:     try:\n155:         dev_status.load_status(tmp_path)\n156:     except ValueError as exc:\n157:         assert \"unknown id\" in str(exc)\n158:     else:\n159:         raise AssertionError(\"dangling dependency accepted\")\n160: \n161: \n162: def test_cycle_refused(tmp_path):\n163:     tasks = [\n164:         _ticket(\"A\", \"PLANNED\", [\"B\"], \"NOT_STARTED\"),\n165:         _ticket(\"B\", \"PLANNED\", [\"A\"], \"NOT_STARTED\"),\n166:     ]\n167:     tickets, stage = _canonical(tasks)\n168:     _write_canonical(tmp_path, tickets, stage)\n169:     try:\n170:         dev_status.load_status(tmp_path)\n171:     except ValueError as exc:\n172:         assert \"cycle\" in str(exc)\n173:     else:\n174:         raise AssertionError(\"cycle accepted\")\n175: \n176: \n177: def test_stage_count_mismatch_refused(tmp_path):\n178:     tickets, stage = _simple_canonical()\n179:     stage[\"counts\"][\"NOT_STARTED\"] = 99\n180:     _write_canonical(tmp_path, tickets, stage)\n181:     try:\n182:         dev_status.load_status(tmp_path)\n183:     except ValueError as exc:\n184:         assert \"stage count mismatch\" in str(exc)\n185:     else:\n186:         raise AssertionError(\"count mismatch accepted\")\n187: \n188: \n189: def test_paused_execution_blocks_dispatch(tmp_path):\n190:     tickets, stage = _simple_canonical(\n191:         execution_control=_execution_control(status=STOPPED),\n192:         stage_control=_execution_control(status=STOPPED),\n193:     )\n194:     _write_canonical(tmp_path, tickets, stage)\n195:     status = dev_status.load_status(tmp_path)\n196:     assert status[\"paused\"] is True\n197:     assert status[\"ready\"] == []\n198:     node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN01\"]\n199:     assert node[\"ready\"] is False\n200:     assert node[\"state\"] == \"PAUSED_DISPATCH\"\n201: \n202: \n203: def test_start_next_ticket_false_blocks_dispatch(tmp_path):\n204:     tickets, stage = _simple_canonical(\n205:         execution_control=_execution_control(start=False),\n206:         stage_control=_execution_control(start=False),\n207:     )\n208:     _write_canonical(tmp_path, tickets, stage)\n209:     status = dev_status.load_status(tmp_path)\n210:     assert status[\"ready\"] == []\n211:     assert status[\"execution_control\"][\"start_next_ticket\"][\"tickets\"] is False\n212: \n213: \n214: def test_running_not_ready(tmp_path):\n215:     tickets, stage = _simple_canonical(\n216:         tooling=[_tooling_ticket(\"O00\", \"RUNNING\", [\"VN00\"]), _tooling_ticket(\"R00\", \"ACCEPTED\", [])],\n217:     )\n218:     _write_canonical(tmp_path, tickets, stage)\n219:     status = dev_status.load_status(tmp_path)\n220:     node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"O00\"]\n221:     assert node[\"running\"] is True\n222:     assert node[\"state\"] == \"RUNNING\"\n223:     assert node[\"ready\"] is False\n224:     assert status[\"running\"] == [\"O00\"]\n225:     assert status[\"ready\"] == [\"VN01\"]\n226:     tooling = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"R00\"]\n227:     assert tooling[\"complete\"] is True\n228:     assert tooling[\"state\"] == \"COMPLETE\"\n229: \n230: \n231: def test_vn20_external(tmp_path):\n232:     tasks = [\n233:         _ticket(\"VN00\", \"COMPLETE_CURRENT_READ_ONLY_BASELINE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n234:         _ticket(\"VN19\", \"COMPLETE_REVIEW_PACKAGE_PREPARED\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n235:         _ticket(\"VN20\", \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\", [\"VN19\"], \"NOT_STARTED\"),\n236:     ]\n237:     stage_tasks = [\n238:         _stage_task(\"VN00\", \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n239:         _stage_task(\"VN19\", \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n240:         _stage_task(\"VN20\", \"NOT_STARTED\"),\n241:     ]\n242:     tickets, stage = _canonical(tasks, stage_tasks=stage_tasks)\n243:     _write_canonical(tmp_path, tickets, stage)\n244:     status = dev_status.load_status(tmp_path)\n245:     node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN20\"]\n246:     assert node[\"external\"] is True\n247:     assert node[\"ready\"] is False\n248:     assert node[\"state\"] == \"EXTERNAL\"\n249:     assert node[\"stage\"] == \"NOT_STARTED\"\n250:     assert node[\"status\"] == \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\"\n251:     assert node[\"missing_dependencies\"] == []\n252:     assert \"VN20\" in status[\"external\"]\n253: \n254: \n255: def test_ro_union_without_changing_vn_tx_counts(tmp_path):\n256:     tooling = [\n257:         _tooling_ticket(\"R00\", \"ACCEPTED\", []),\n258:         _tooling_ticket(\"R01\", \"PLANNED\", [\"R00\"]),\n259:         _tooling_ticket(\"O00\", \"RUNNING\", [\"R00\"]),\n260:         _tooling_ticket(\"O01\", \"PLANNED\", [\"R01\", \"O00\"]),\n261:     ]\n262:     tickets, stage = _simple_canonical(tooling=tooling)\n263:     _write_canonical(tmp_path, tickets, stage)\n264:     status = dev_status.load_status(tmp_path)\n265:     assert status[\"node_totals\"][\"VN_TX\"] == 3\n266:     assert status[\"node_totals\"][\"RO\"] == 4\n267:     for category, value in status[\"counts\"].items():\n268:         assert value == stage[\"counts\"][category]\n269:     assert status[\"tooling_counts\"] == {\"ACCEPTED\": 1, \"PLANNED\": 2, \"RUNNING\": 1}\n270:     o01 = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"O01\"]\n271:     assert o01[\"state\"] == \"BLOCKED\"\n272:     assert sorted(o01[\"missing_dependencies\"]) == [\"O00\", \"R01\"]\n273:     assert status[\"ready\"] == [\"VN01\", \"R01\"]\n274: \n275: \n276: def test_last_completed_ticket_conflict_refused(tmp_path):\n277:     tickets, stage = _simple_canonical(\n278:         stage_control=_execution_control(last=\"VN99\"),\n279:     )\n280:     _write_canonical(tmp_path, tickets, stage)\n281:     try:\n282:         dev_status.load_status(tmp_path)\n283:     except ValueError as exc:\n284:         assert \"conflict\" in str(exc)\n285:     else:\n286:         raise AssertionError(\"conflicting completion records accepted\")\n287: \n288: \n289: def test_real_copied_canonical_cli(tmp_path):\n290:     canonical = REPO_ROOT / TICKETS_DIR\n291:     directory = tmp_path / TICKETS_DIR\n292:     directory.mkdir(parents=True)\n293:     for name in (\"tickets_production.json\", \"stage_status.json\"):\n294:         source = canonical / name\n295:         assert source.is_file(), f\"missing real canonical file: {source}\"\n296:         (directory / name).write_bytes(source.read_bytes())\n297:     status = dev_status.load_status(tmp_path)\n298:     assert status[\"node_totals\"][\"VN_TX\"] == 51\n299:     assert status[\"node_totals\"][\"RO\"] == 9\n300:     assert len(status[\"nodes\"]) == 60\n301:     assert status[\"counts\"] == {\n302:         \"COMPLETE_LOCAL_IMPLEMENTATION\": 14,\n303:         \"INCOMPLETE\": 23,\n304:         \"NOT_STARTED\": 14,\n305:     }\n306:     for node in status[\"nodes\"]:\n307:         if node[\"family\"] == \"VN/TX\":\n308:             assert node[\"stage\"] in {\"COMPLETE_LOCAL_IMPLEMENTATION\", \"INCOMPLETE\", \"NOT_STARTED\"}\n309:     completed = [n for n in status[\"nodes\"] if n[\"complete\"]]\n310:     assert len(completed) == 15\n311:     assert {n[\"task_id\"] for n in completed if n[\"family\"] == \"VN/TX\"} == {\n312:         \"VN00\", \"VN01\", \"VN02\", \"VN03\", \"VN04A\", \"VN04B\", \"VN05\", \"VN06\",\n313:         \"VN10\", \"VN11\", \"VN12\", \"VN14A\", \"VN14B\", \"VN16\",\n314:     }\n315:     assert {n[\"task_id\"] for n in completed if n[\"family\"] == \"R/O\"} == {\"R00\"}\n316:     assert status[\"last_completed_ticket\"] == \"VN14B\"\n317:     assert status[\"last_completed_tooling_ticket\"] == \"R00\"\n318:     assert {n[\"task_id\"] for n in completed if n[\"family\"] == \"R/O\"} == {\"R00\"}\n319:     assert status[\"ready\"] == [\"VN07\", \"TX00\", \"R01\"]\n320:     running = {n[\"task_id\"] for n in status[\"running\"]}\n321:     assert running == {\"O00\"}\n322:     vn20 = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN20\"]\n323:     assert vn20[\"state\"] == \"EXTERNAL\" and vn20[\"ready\"] is False\n324: \n325:     result = subprocess.run(\n326:         [sys.executable, str(STATUS_SCRIPT), \"--root\", str(tmp_path), \"--json\"],\n327:         capture_output=True,\n328:         text=True,\n329:         timeout=30,\n330:     )\n331:     assert result.returncode == 0, result.stderr\n332:     projection = json.loads(result.stdout)\n333:     assert projection[\"node_totals\"] == {\"VN_TX\": 51, \"RO\": 9}\n\n(End of file - total 333 lines)\n</content>","metadata":{"preview":"\"\"\"R01 acceptance tests: deterministic read-only status projection.\"\"\"\n\nimport importlib.util\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\nSTATUS_SCRIPT = REPO_ROOT / \"scripts\" / \"dev\" / \"status.py\"\n\nspec = importlib.util.spec_from_file_location(\"dev_status\", STATUS_SCRIPT)\ndev_status = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(dev_status)\n\nACTIVE = \"RUNNING_LOCAL_REFACTORING\"\nSTOPPED = \"STOPPED_AT_USER_REQUEST\"\n\nTICKETS_DIR = \"docs/refactoring/vnext\"\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/work/tests/refactoring/test_dev_status.py","text":"\"\"\"R01 acceptance tests: deterministic read-only status projection.\"\"\"\n\nimport importlib.util\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\nSTATUS_SCRIPT = REPO_ROOT / \"scripts\" / \"dev\" / \"status.py\"\n\nspec = importlib.util.spec_from_file_location(\"dev_status\", STATUS_SCRIPT)\ndev_status = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(dev_status)\n\nACTIVE = \"RUNNING_LOCAL_REFACTORING\"\nSTOPPED = \"STOPPED_AT_USER_REQUEST\"\n\nTICKETS_DIR = \"docs/refactoring/vnext\"\n\n\ndef _write_canonical(root: Path, tickets: dict, stage: dict) -> None:\n    directory = root / TICKETS_DIR\n    directory.mkdir(parents=True, exist_ok=True)\n    (directory / \"tickets_production.json\").write_text(json.dumps(tickets), encoding=\"utf-8\")\n    (directory / \"stage_status.json\").write_text(json.dumps(stage), encoding=\"utf-8\")\n\n\ndef _execution_control(status=ACTIVE, start=True, last=\"VN00\", last_tooling=\"R00\"):\n    return {\n        \"status\": status,\n        \"last_completed_ticket\": last,\n        \"last_completed_tooling_ticket\": last_tooling,\n        \"active_ticket\": None,\n        \"start_next_ticket\": start,\n        \"stop_after_ticket\": None,\n        \"server_deploy_authorized\": False,\n        \"live_mutation_authorized\": False,\n    }\n\n\ndef _ticket(task_id, status, deps, classification):\n    return {\n        \"task_id\": task_id,\n        \"existing_phase\": None,\n        \"status\": status,\n        \"depends_on\": deps,\n        \"baseline\": {\"head\": \"0\" * 40},\n        \"stage_classification\": classification,\n    }\n\n\ndef _tooling_ticket(task_id, status, deps):\n    return {\"task_id\": task_id, \"status\": status, \"depends_on\": deps, \"scope\": \"LOCAL_ONLY\", \"receipt\": None}\n\n\ndef _stage_task(task_id, category):\n    return {\"task_id\": task_id, \"category\": category}\n\n\ndef _canonical(\n    tasks,\n    tooling=(),\n    stage_tasks=None,\n    counts=None,\n    execution_control=None,\n    stage_control=None,\n    last=\"VN00\",\n    last_tooling=\"R00\",\n):\n    ec = execution_control or _execution_control(last=last, last_tooling=last_tooling)\n    stage_ec = stage_control or _execution_control(last=last, last_tooling=last_tooling)\n    if stage_tasks is None:\n        stage_tasks = [\n            _stage_task(t[\"task_id\"], t[\"stage_classification\"]) for t in tasks\n        ]\n    if counts is None:\n        counts = {}\n        for st in stage_tasks:\n            counts[st[\"category\"]] = counts.get(st[\"category\"], 0) + 1\n    tickets = {\n        \"schema_version\": 1,\n        \"tasks\": tasks,\n        \"tooling_tasks\": list(tooling),\n        \"execution_control\": ec,\n    }\n    stage = {\n        \"schema_version\": 1,\n        \"counts\": counts,\n        \"tasks\": stage_tasks,\n        \"execution_control\": stage_ec,\n    }\n    return tickets, stage\n\n\ndef _simple_canonical(tooling=(), **overrides):\n    tasks = [\n        _ticket(\"VN00\", \"COMPLETE_CURRENT_READ_ONLY_BASELINE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n        _ticket(\"VN01\", \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\", [\"VN00\"], \"NOT_STARTED\"),\n        _ticket(\"VN20\", \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\", [\"VN01\"], \"NOT_STARTED\"),\n    ]\n    tickets, stage = _canonical(tasks, tooling, **overrides)\n    stage[\"tasks\"] = stage[\"tasks\"][:2] + [_stage_task(\"VN20\", \"NOT_STARTED\")]\n    return tickets, stage\n\n\ndef test_ready_dependency_satisfaction(tmp_path):\n    tickets, stage = _simple_canonical()\n    _write_canonical(tmp_path, tickets, stage)\n    status = dev_status.load_status(tmp_path)\n    node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN01\"]\n    assert node[\"ready\"] is True\n    assert node[\"state\"] == \"READY\"\n    assert node[\"missing_dependencies\"] == []\n    assert status[\"ready\"] == [\"VN01\"]\n    assert status[\"paused\"] is False\n\n\ndef test_false_predecessor_not_accepted(tmp_path):\n    tasks = [\n        _ticket(\"VN00\", \"PARTIAL_DONE_STATUS\", [], \"INCOMPLETE\"),\n        _ticket(\"VN01\", \"PLANNED\", [\"VN00\"], \"NOT_STARTED\"),\n    ]\n    tickets, stage = _canonical(tasks)\n    _write_canonical(tmp_path, tickets, stage)\n    status = dev_status.load_status(tmp_path)\n    node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN01\"]\n    assert node[\"ready\"] is False\n    assert node[\"state\"] == \"BLOCKED\"\n    assert node[\"missing_dependencies\"] == [\"VN00\"]\n    assert status[\"ready\"] == [\"VN00\"]\n\n\ndef test_duplicate_id_refused(tmp_path):\n    tasks = [\n        _ticket(\"VN00\", \"DONE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n        _ticket(\"VN00\", \"DONE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n    ]\n    tickets, stage = _canonical(tasks)\n    stage[\"tasks\"] = [_stage_task(\"VN00\", \"COMPLETE_LOCAL_IMPLEMENTATION\")]\n    _write_canonical(tmp_path, tickets, stage)\n    try:\n        dev_status.load_status(tmp_path)\n    except ValueError as exc:\n        assert \"duplicate task_id\" in str(exc)\n    else:\n        raise AssertionError(\"duplicate id accepted\")\n\n\ndef test_dangling_dependency_refused(tmp_path):\n    tasks = [_ticket(\"VN01\", \"PLANNED\", [\"VNMISSING\"], \"NOT_STARTED\")]\n    tickets, stage = _canonical(tasks)\n    _write_canonical(tmp_path, tickets, stage)\n    try:\n        dev_status.load_status(tmp_path)\n    except ValueError as exc:\n        assert \"unknown id\" in str(exc)\n    else:\n        raise AssertionError(\"dangling dependency accepted\")\n\n\ndef test_cycle_refused(tmp_path):\n    tasks = [\n        _ticket(\"A\", \"PLANNED\", [\"B\"], \"NOT_STARTED\"),\n        _ticket(\"B\", \"PLANNED\", [\"A\"], \"NOT_STARTED\"),\n    ]\n    tickets, stage = _canonical(tasks)\n    _write_canonical(tmp_path, tickets, stage)\n    try:\n        dev_status.load_status(tmp_path)\n    except ValueError as exc:\n        assert \"cycle\" in str(exc)\n    else:\n        raise AssertionError(\"cycle accepted\")\n\n\ndef test_stage_count_mismatch_refused(tmp_path):\n    tickets, stage = _simple_canonical()\n    stage[\"counts\"][\"NOT_STARTED\"] = 99\n    _write_canonical(tmp_path, tickets, stage)\n    try:\n        dev_status.load_status(tmp_path)\n    except ValueError as exc:\n        assert \"stage count mismatch\" in str(exc)\n    else:\n        raise AssertionError(\"count mismatch accepted\")\n\n\ndef test_paused_execution_blocks_dispatch(tmp_path):\n    tickets, stage = _simple_canonical(\n        execution_control=_execution_control(status=STOPPED),\n        stage_control=_execution_control(status=STOPPED),\n    )\n    _write_canonical(tmp_path, tickets, stage)\n    status = dev_status.load_status(tmp_path)\n    assert status[\"paused\"] is True\n    assert status[\"ready\"] == []\n    node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN01\"]\n    assert node[\"ready\"] is False\n    assert node[\"state\"] == \"PAUSED_DISPATCH\"\n\n\ndef test_start_next_ticket_false_blocks_dispatch(tmp_path):\n    tickets, stage = _simple_canonical(\n        execution_control=_execution_control(start=False),\n        stage_control=_execution_control(start=False),\n    )\n    _write_canonical(tmp_path, tickets, stage)\n    status = dev_status.load_status(tmp_path)\n    assert status[\"ready\"] == []\n    assert status[\"execution_control\"][\"start_next_ticket\"][\"tickets\"] is False\n\n\ndef test_running_not_ready(tmp_path):\n    tickets, stage = _simple_canonical(\n        tooling=[_tooling_ticket(\"O00\", \"RUNNING\", [\"VN00\"]), _tooling_ticket(\"R00\", \"ACCEPTED\", [])],\n    )\n    _write_canonical(tmp_path, tickets, stage)\n    status = dev_status.load_status(tmp_path)\n    node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"O00\"]\n    assert node[\"running\"] is True\n    assert node[\"state\"] == \"RUNNING\"\n    assert node[\"ready\"] is False\n    assert status[\"running\"] == [\"O00\"]\n    assert status[\"ready\"] == [\"VN01\"]\n    tooling = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"R00\"]\n    assert tooling[\"complete\"] is True\n    assert tooling[\"state\"] == \"COMPLETE\"\n\n\ndef test_vn20_external(tmp_path):\n    tasks = [\n        _ticket(\"VN00\", \"COMPLETE_CURRENT_READ_ONLY_BASELINE\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n        _ticket(\"VN19\", \"COMPLETE_REVIEW_PACKAGE_PREPARED\", [], \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n        _ticket(\"VN20\", \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\", [\"VN19\"], \"NOT_STARTED\"),\n    ]\n    stage_tasks = [\n        _stage_task(\"VN00\", \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n        _stage_task(\"VN19\", \"COMPLETE_LOCAL_IMPLEMENTATION\"),\n        _stage_task(\"VN20\", \"NOT_STARTED\"),\n    ]\n    tickets, stage = _canonical(tasks, stage_tasks=stage_tasks)\n    _write_canonical(tmp_path, tickets, stage)\n    status = dev_status.load_status(tmp_path)\n    node = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN20\"]\n    assert node[\"external\"] is True\n    assert node[\"ready\"] is False\n    assert node[\"state\"] == \"EXTERNAL\"\n    assert node[\"stage\"] == \"NOT_STARTED\"\n    assert node[\"status\"] == \"PLANNED_LOCAL_AUTHORIZED_SUBJECT_TO_PREREQUISITES\"\n    assert node[\"missing_dependencies\"] == []\n    assert \"VN20\" in status[\"external\"]\n\n\ndef test_ro_union_without_changing_vn_tx_counts(tmp_path):\n    tooling = [\n        _tooling_ticket(\"R00\", \"ACCEPTED\", []),\n        _tooling_ticket(\"R01\", \"PLANNED\", [\"R00\"]),\n        _tooling_ticket(\"O00\", \"RUNNING\", [\"R00\"]),\n        _tooling_ticket(\"O01\", \"PLANNED\", [\"R01\", \"O00\"]),\n    ]\n    tickets, stage = _simple_canonical(tooling=tooling)\n    _write_canonical(tmp_path, tickets, stage)\n    status = dev_status.load_status(tmp_path)\n    assert status[\"node_totals\"][\"VN_TX\"] == 3\n    assert status[\"node_totals\"][\"RO\"] == 4\n    for category, value in status[\"counts\"].items():\n        assert value == stage[\"counts\"][category]\n    assert status[\"tooling_counts\"] == {\"ACCEPTED\": 1, \"PLANNED\": 2, \"RUNNING\": 1}\n    o01 = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"O01\"]\n    assert o01[\"state\"] == \"BLOCKED\"\n    assert sorted(o01[\"missing_dependencies\"]) == [\"O00\", \"R01\"]\n    assert status[\"ready\"] == [\"VN01\", \"R01\"]\n\n\ndef test_last_completed_ticket_conflict_refused(tmp_path):\n    tickets, stage = _simple_canonical(\n        stage_control=_execution_control(last=\"VN99\"),\n    )\n    _write_canonical(tmp_path, tickets, stage)\n    try:\n        dev_status.load_status(tmp_path)\n    except ValueError as exc:\n        assert \"conflict\" in str(exc)\n    else:\n        raise AssertionError(\"conflicting completion records accepted\")\n\n\ndef test_real_copied_canonical_cli(tmp_path):\n    canonical = REPO_ROOT / TICKETS_DIR\n    directory = tmp_path / TICKETS_DIR\n    directory.mkdir(parents=True)\n    for name in (\"tickets_production.json\", \"stage_status.json\"):\n        source = canonical / name\n        assert source.is_file(), f\"missing real canonical file: {source}\"\n        (directory / name).write_bytes(source.read_bytes())\n    status = dev_status.load_status(tmp_path)\n    assert status[\"node_totals\"][\"VN_TX\"] == 51\n    assert status[\"node_totals\"][\"RO\"] == 9\n    assert len(status[\"nodes\"]) == 60\n    assert status[\"counts\"] == {\n        \"COMPLETE_LOCAL_IMPLEMENTATION\": 14,\n        \"INCOMPLETE\": 23,\n        \"NOT_STARTED\": 14,\n    }\n    for node in status[\"nodes\"]:\n        if node[\"family\"] == \"VN/TX\":\n            assert node[\"stage\"] in {\"COMPLETE_LOCAL_IMPLEMENTATION\", \"INCOMPLETE\", \"NOT_STARTED\"}\n    completed = [n for n in status[\"nodes\"] if n[\"complete\"]]\n    assert len(completed) == 15\n    assert {n[\"task_id\"] for n in completed if n[\"family\"] == \"VN/TX\"} == {\n        \"VN00\", \"VN01\", \"VN02\", \"VN03\", \"VN04A\", \"VN04B\", \"VN05\", \"VN06\",\n        \"VN10\", \"VN11\", \"VN12\", \"VN14A\", \"VN14B\", \"VN16\",\n    }\n    assert {n[\"task_id\"] for n in completed if n[\"family\"] == \"R/O\"} == {\"R00\"}\n    assert status[\"last_completed_ticket\"] == \"VN14B\"\n    assert status[\"last_completed_tooling_ticket\"] == \"R00\"\n    assert {n[\"task_id\"] for n in completed if n[\"family\"] == \"R/O\"} == {\"R00\"}\n    assert status[\"ready\"] == [\"VN07\", \"TX00\", \"R01\"]\n    running = {n[\"task_id\"] for n in status[\"running\"]}\n    assert running == {\"O00\"}\n    vn20 = {n[\"task_id\"]: n for n in status[\"nodes\"]}[\"VN20\"]\n    assert vn20[\"state\"] == \"EXTERNAL\" and vn20[\"ready\"] is False\n\n    result = subprocess.run(\n        [sys.executable, str(STATUS_SCRIPT), \"--root\", str(tmp_path), \"--json\"],\n        capture_output=True,\n        text=True,\n        timeout=30,\n    )\n    assert result.returncode == 0, result.stderr\n    projection = json.loads(result.stdout)\n    assert projection[\"node_totals\"] == {\"VN_TX\": 51, \"RO\": 9}","lineStart":1,"lineEnd":333,"totalLines":333,"truncated":false}},"title":"tests/refactoring/test_dev_status.py","time":{"start":1792687897800,"end":1792687897833}},"id":"prt_164867cc0001BBx9vu43DI4Wes","sessionID":"ses_e9b79d248ffe6pD2GFdVT2YUYs","messageID":"msg_164864e24001ui2YeLJ9b7AFA0"}}
