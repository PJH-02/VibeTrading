{"type":"tool_use","timestamp":1792687885158,"sessionID":"ses_e9b79d248ffe6pD2GFdVT2YUYs","part":{"type":"tool","tool":"read","callID":"call_9f6e117b2a8a45a896e54a39","state":{"status":"completed","input":{"filePath":"/work/scripts/dev/status.py"},"output":"<path>/work/scripts/dev/status.py</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env python3\n2: \"\"\"Deterministic read-only status projection for the v3 refactoring DAG.\n3: \n4: Stdlib only. Reads the two canonical JSON files under docs/refactoring/vnext/\n5: (the original VN/TX stage plan plus R/O tooling tickets) and emits a bounded\n6: projection. It never writes canonical JSON and never infers completion from a\n7: substring of a status string.\n8: \"\"\"\n9: \n10: from __future__ import annotations\n11: \n12: import argparse\n13: import json\n14: import subprocess\n15: import sys\n16: from pathlib import Path\n17: \n18: VNEXT_DIR = Path(\"docs\") / \"refactoring\" / \"vnext\"\n19: TICKETS_CANONICAL = VNEXT_DIR / \"tickets_production.json\"\n20: STAGE_CANONICAL = VNEXT_DIR / \"stage_status.json\"\n21: \n22: COMPLETE_STAGE = \"COMPLETE_LOCAL_IMPLEMENTATION\"\n23: ORIGINAL_STAGES = {COMPLETE_STAGE, \"INCOMPLETE\", \"NOT_STARTED\"}\n24: TOOLING_COMPLETE_STATUS = \"ACCEPTED\"\n25: RUNNING_STATUS = \"RUNNING\"\n26: ACTIVE_EXECUTION_STATUSES = {\"RUNNING_LOCAL_REFACTORING\"}\n27: EXTERNAL_TASK_IDS = {\"VN20\"}\n28: \n29: STATE_COMPLETE = \"COMPLETE\"\n30: STATE_RUNNING = \"RUNNING\"\n31: STATE_EXTERNAL = \"EXTERNAL\"\n32: STATE_BLOCKED = \"BLOCKED\"\n33: STATE_READY = \"READY\"\n34: STATE_PAUSED = \"PAUSED_DISPATCH\"\n35: \n36: \n37: def _load_json(path: Path) -> dict:\n38:     if not path.is_file():\n39:         raise ValueError(f\"canonical file missing: {path}\")\n40:     try:\n41:         with path.open(\"r\", encoding=\"utf-8\") as fh:\n42:             data = json.load(fh)\n43:     except (OSError, json.JSONDecodeError) as exc:\n44:         raise ValueError(f\"cannot parse {path}: {exc}\") from exc\n45:     if not isinstance(data, dict):\n46:         raise ValueError(f\"{path} must contain a JSON object\")\n47:     return data\n48: \n49: \n50: def _require_str(value, label: str) -> str:\n51:     if not isinstance(value, str) or not value:\n52:         raise ValueError(f\"{label} must be a non-empty string\")\n53:     return value\n54: \n55: \n56: def _require_str_list(value, label: str) -> list:\n57:     if not isinstance(value, list) or not all(isinstance(x, str) for x in value):\n58:         raise ValueError(f\"{label} must be a list of strings\")\n59:     return sorted(value)\n60: \n61: \n62: def _execution_control(data: dict, label: str) -> dict:\n63:     ec = data.get(\"execution_control\")\n64:     if not isinstance(ec, dict):\n65:         raise ValueError(f\"{label}: execution_control object missing\")\n66:     status = _require_str(ec.get(\"status\"), f\"{label}: execution_control.status\")\n67:     if not isinstance(ec.get(\"start_next_ticket\"), bool):\n68:         raise ValueError(f\"{label}: execution_control.start_next_ticket must be boolean\")\n69:     last = _require_str(ec.get(\"last_completed_ticket\"), f\"{label}: execution_control.last_completed_ticket\")\n70:     return {\n71:         \"status\": status,\n72:         \"start_next_ticket\": ec[\"start_next_ticket\"],\n73:         \"last_completed_ticket\": last,\n74:         \"last_completed_tooling_ticket\": ec.get(\"last_completed_tooling_ticket\"),\n75:     }\n76: \n77: \n78: def _collect_tasks(tickets: dict) -> tuple:\n79:     \"\"\"Validate IDs, dependencies and cycles; return (original, tooling) records.\"\"\"\n80:     tasks = tickets.get(\"tasks\")\n81:     tooling = tickets.get(\"tooling_tasks\", [])\n82:     if not isinstance(tasks, list) or not tasks:\n83:         raise ValueError(\"tickets_production.json: tasks must be a non-empty list\")\n84:     if not isinstance(tooling, list):\n85:         raise ValueError(\"tickets_production.json: tooling_tasks must be a list\")\n86:     records, tooling_records, seen = [], [], set()\n87:     for raw in tasks:\n88:         records.append(_record(raw, \"VN/TX\", \"tasks\", seen))\n89:     for raw in tooling:\n90:         tooling_records.append(_record(raw, \"R/O\", \"tooling_tasks\", seen))\n91:     known = seen\n92:     all_records = records + tooling_records\n93:     for rec in all_records:\n94:         for dep in rec[\"depends_on\"]:\n95:             if dep not in known:\n96:                 raise ValueError(f\"{rec['task_id']} depends on unknown id: {dep}\")\n97:     _no_cycles(all_records)\n98:     return records, tooling_records\n99: \n100: \n101: def _record(raw, family: str, label: str, seen: set) -> dict:\n102:     tid = _require_str(raw.get(\"task_id\"), f\"{label}[].task_id\")\n103:     if tid in seen:\n104:         raise ValueError(f\"duplicate task_id: {tid}\")\n105:     seen.add(tid)\n106:     return {\n107:         \"task_id\": tid,\n108:         \"family\": family,\n109:         \"status\": _require_str(raw.get(\"status\"), f\"{tid}.status\"),\n110:         \"depends_on\": _require_str_list(raw.get(\"depends_on\"), f\"{tid}.depends_on\"),\n111:         \"stage_classification\": raw.get(\"stage_classification\"),\n112:     }\n113: \n114: \n115: def _no_cycles(records: list) -> None:\n116:     edges = {r[\"task_id\"]: r[\"depends_on\"] for r in records}\n117:     state: dict = {}\n118: \n119:     def visit(node: str) -> None:\n120:         if state.get(node) == 1:\n121:             raise ValueError(f\"dependency cycle involves {node}\")\n122:         if state.get(node) == 2:\n123:             return\n124:         state[node] = 1\n125:         for dep in edges[node]:\n126:             visit(dep)\n127:         state[node] = 2\n128: \n129:     for node in edges:\n130:         visit(node)\n131: \n132: \n133: def _stage_authority(stage: dict, records: list) -> tuple:\n134:     \"\"\"Validate stage_status.json; return (category_by_id, declared_counts).\"\"\"\n135:     declared = stage.get(\"counts\")\n136:     tasks = stage.get(\"tasks\")\n137:     if not isinstance(declared, dict) or not declared:\n138:         raise ValueError(\"stage_status.json: counts object missing\")\n139:     if not isinstance(tasks, list) or not tasks:\n140:         raise ValueError(\"stage_status.json: tasks must be a non-empty list\")\n141:     category_by_id, tally, seen = {}, {}, set()\n142:     for raw in tasks:\n143:         tid = _require_str(raw.get(\"task_id\"), \"stage_status tasks[].task_id\")\n144:         if tid in seen:\n145:             raise ValueError(f\"duplicate stage task_id: {tid}\")\n146:         seen.add(tid)\n147:         category = _require_str(raw.get(\"category\"), f\"{tid}.category\")\n148:         if category not in ORIGINAL_STAGES:\n149:             raise ValueError(f\"{tid}: unknown stage category {category}\")\n150:         category_by_id[tid] = category\n151:         tally[category] = tally.get(category, 0) + 1\n152:     original_ids = {r[\"task_id\"] for r in records}\n153:     if seen != original_ids:\n154:         raise ValueError(\n155:             \"stage_status.json: stage tasks do not match original VN/TX records \"\n156:             f\"(missing={sorted(original_ids - seen)}, extra={sorted(seen - original_ids)})\"\n157:         )\n158:     for category in sorted(set(declared) | set(tally)):\n159:         declared_value = declared.get(category, 0)\n160:         if not isinstance(declared_value, int) or declared_value != tally.get(category, 0):\n161:             raise ValueError(\n162:                 f\"stage count mismatch for {category}: declared={declared_value} \"\n163:                 f\"actual={tally.get(category, 0)}\"\n164:             )\n165:     return category_by_id, dict(declared)\n166: \n167: \n168: def load_status(root: Path) -> dict:\n169:     \"\"\"Build the deterministic read-only status projection (no writes).\"\"\"\n170:     root = Path(root)\n171:     tickets_path = root / TICKETS_CANONICAL\n172:     stage_path = root / STAGE_CANONICAL\n173:     tickets = _load_json(tickets_path)\n174:     stage_data = _load_json(stage_path)\n175:     tickets_ec = _execution_control(tickets, str(TICKETS_CANONICAL))\n176:     stage_ec = _execution_control(stage_data, str(STAGE_CANONICAL))\n177:     if tickets_ec[\"last_completed_ticket\"] != stage_ec[\"last_completed_ticket\"]:\n178:         raise ValueError(\n179:             \"last_completed_ticket conflict: \"\n180:             f\"tickets={tickets_ec['last_completed_ticket']} \"\n181:             f\"stage_status={stage_ec['last_completed_ticket']}\"\n182:         )\n183:     records, tooling_records = _collect_tasks(tickets)\n184:     category_by_id, stage_counts = _stage_authority(stage_data, records)\n185: \n186:     for rec in records:\n187:         if rec[\"stage_classification\"] is not None and rec[\"stage_classification\"] != category_by_id[rec[\"task_id\"]]:\n188:             raise ValueError(\n189:                 f\"{rec['task_id']}: stage_classification {rec['stage_classification']!r} \"\n190:                 f\"conflicts with stage category {category_by_id[rec['task_id']]!r}\"\n191:             )\n192: \n193:     all_records = records + tooling_records\n194:     ticket_ids = set(category_by_id)\n195:     complete_by_id: dict = {}\n196:     for rec in all_records:\n197:         if rec[\"family\"] == \"VN/TX\":\n198:             complete_by_id[rec[\"task_id\"]] = category_by_id[rec[\"task_id\"]] == COMPLETE_STAGE\n199:         else:\n200:             complete_by_id[rec[\"task_id\"]] = rec[\"status\"] == TOOLING_COMPLETE_STATUS\n201: \n202:     paused = any(ec[\"status\"] not in ACTIVE_EXECUTION_STATUSES for ec in (tickets_ec, stage_ec))\n203:     gates_open = not paused and tickets_ec[\"start_next_ticket\"] and stage_ec[\"start_next_ticket\"]\n204: \n205:     nodes = []\n206:     for rec in all_records:\n207:         tid = rec[\"task_id\"]\n208:         stage = category_by_id.get(tid)\n209:         running = rec[\"status\"] == RUNNING_STATUS\n210:         external = tid in EXTERNAL_TASK_IDS\n211:         missing = [dep for dep in rec[\"depends_on\"] if not complete_by_id[dep]]\n212:         ready = not complete_by_id[tid] and not running and not external and not missing and gates_open\n213:         if complete_by_id[tid]:\n214:             state = STATE_COMPLETE\n215:         elif running:\n216:             state = STATE_RUNNING\n217:         elif external:\n218:             state = STATE_EXTERNAL\n219:         elif missing:\n220:             state = STATE_BLOCKED\n221:         elif ready:\n222:             state = STATE_READY\n223:         else:\n224:             state = STATE_PAUSED\n225:         nodes.append(\n226:             {\n227:                 \"task_id\": tid,\n228:                 \"family\": rec[\"family\"],\n229:                 \"status\": rec[\"status\"],\n230:                 \"stage\": stage,\n231:                 \"depends_on\": rec[\"depends_on\"],\n232:                 \"complete\": complete_by_id[tid],\n233:                 \"running\": running,\n234:                 \"external\": external,\n235:                 \"missing_dependencies\": missing,\n236:                 \"state\": state,\n237:                 \"ready\": ready,\n238:             }\n239:         )\n240:     tooling_tally: dict = {}\n241:     for node in nodes:\n242:         if node[\"family\"] == \"R/O\":\n243:             tooling_tally[node[\"status\"]] = tooling_tally.get(node[\"status\"], 0) + 1\n244:     return {\n245:         \"schema_version\": 1,\n246:         \"sources\": {\"tickets\": str(TICKETS_CANONICAL), \"stage_status\": str(STAGE_CANONICAL)},\n247:         \"execution_control\": {\n248:             \"tickets_status\": tickets_ec[\"status\"],\n249:             \"stage_status_status\": stage_ec[\"status\"],\n250:             \"start_next_ticket\": {\n251:                 \"tickets\": tickets_ec[\"start_next_ticket\"],\n252:                 \"stage_status\": stage_ec[\"start_next_ticket\"],\n253:             },\n254:             \"paused\": paused,\n255:         },\n256:         \"counts\": stage_counts,\n257:         \"tooling_counts\": tooling_tally,\n258:         \"node_totals\": {\"VN_TX\": len(records), \"RO\": len(tooling_records)},\n259:         \"ready\": [n[\"task_id\"] for n in nodes if n[\"ready\"]],\n260:         \"running\": [n[\"task_id\"] for n in nodes if n[\"running\"]],\n261:         \"external\": [n[\"task_id\"] for n in nodes if n[\"external\"]],\n262:         \"nodes\": nodes,\n263:         \"paused\": paused,\n264:         \"last_completed_ticket\": tickets_ec[\"last_completed_ticket\"],\n265:         \"last_completed_tooling_ticket\": tickets_ec[\"last_completed_tooling_ticket\"],\n266:     }\n267: \n268: \n269: def render_markdown(status: dict, git_head: str) -> str:\n270:     lines = [\n271:         \"# Local status projection (v3)\",\n272:         \"\",\n273:         f\"Canonical sources: `{status['sources']['tickets']}`, `{status['sources']['stage_status']}`; \"\n274:         \"`context.json` is a bounded derived summary only.\",\n275:         f\"Git HEAD: `{git_head}`\",\n276:         \"\",\n277:         \"## Execution control\",\n278:         \"\",\n279:         f\"- tickets: `{status['execution_control']['tickets_status']}`; start_next_ticket=\"\n280:         f\"`{status['execution_control']['start_next_ticket']['tickets']}`\",\n281:         f\"- stage_status: `{status['execution_control']['stage_status_status']}`; start_next_ticket=\"\n282:         f\"`{status['execution_control']['start_next_ticket']['stage_status']}`\",\n283:         f\"- dispatch paused: `{status['paused']}`\",\n284:         \"\",\n285:         \"## Stage counts (VN/TX)\",\n286:         \"\",\n287:     ]\n288:     for category in sorted(status[\"counts\"]):\n289:         lines.append(f\"- {category}: {status['counts'][category]}\")\n290:     tooling = \", \".join(f\"{name} {value}\" for name, value in sorted(status[\"tooling_counts\"].items())) or \"none\"\n291:     lines += [\n292:         f\"- tooling (R/O): {tooling}\",\n293:         f\"- originals plus tooling: {status['node_totals']['VN_TX']} VN/TX nodes, \"\n294:         f\"{status['node_totals']['RO']} R/O nodes\",\n295:         \"\",\n296:         \"## Progress\",\n297:         \"\",\n298:         f\"- last completed ticket: `{status['last_completed_ticket']}`; last completed tooling \"\n299:         f\"ticket: `{status['last_completed_tooling_ticket']}`\",\n300:         f\"- running (no duplicate dispatch): {', '.join(f'`{x}`' for x in status['running']) or 'none'}\",\n301:         f\"- ready now (dispatch unlocked): {', '.join(f'`{x}`' for x in status['ready']) or 'none'}\",\n302:         f\"- external (never auto-run): {', '.join(f'`{x}`' for x in status['external']) or 'none'}\",\n303:         \"\",\n304:         \"Local/operational distinction: `COMPLETE_LOCAL_IMPLEMENTATION` marks local implementation\",\n305:         \"acceptance only; production, deploy and long-duration resource gates remain open. The\",\n306:         \"canonical record keeps the original VN/TX status strings, e.g. VN07 stays `INCOMPLETE` and\",\n307:         \"VN20 actual cutover/deletion is EXTERNAL and is never executed automatically.\",\n308:         \"\",\n309:     ]\n310:     return \"\\n\".join(lines)\n311: \n312: \n313: def _git_head(root: Path) -> str:\n314:     \"\"\"Record the current Git HEAD; when unavailable, UNKNOWN is explicit.\"\"\"\n315:     try:\n316:         completed = subprocess.run(\n317:             [\"git\", \"rev-parse\", \"HEAD\"], cwd=str(root), capture_output=True, text=True, timeout=10\n318:         )\n319:     except (OSError, subprocess.SubprocessError):\n320:         return \"UNKNOWN\"\n321:     if completed.returncode != 0:\n322:         return \"UNKNOWN\"\n323:     return completed.stdout.strip() or \"UNKNOWN\"\n324: \n325: \n326: def main(argv=None) -> int:\n327:     parser = argparse.ArgumentParser(description=\"Read-only v3 status projection (stdlib only).\")\n328:     parser.add_argument(\"--root\", default=\".\", help=\"repository root to read canonical JSON from\")\n329:     parser.add_argument(\"--json\", action=\"store_true\", help=\"emit JSON projection (default)\")\n330:     parser.add_argument(\"--markdown\", action=\"store_true\", help=\"render concise markdown status\")\n331:     args = parser.parse_args(argv)\n332:     try:\n333:         status = load_status(Path(args.root))\n334:     except ValueError as exc:\n335:         print(f\"status error: {exc}\", file=sys.stderr)\n336:         return 2\n337:     git_head = _git_head(Path(args.root))\n338:     if args.markdown:\n339:         print(render_markdown(status, git_head), end=\"\")\n340:     else:\n341:         status[\"git_head\"] = git_head\n342:         print(json.dumps(status, ensure_ascii=False, indent=2))\n343:     return 0\n344: \n345: \n346: if __name__ == \"__main__\":\n347:     raise SystemExit(main())\n\n(End of file - total 347 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n\"\"\"Deterministic read-only status projection for the v3 refactoring DAG.\n\nStdlib only. Reads the two canonical JSON files under docs/refactoring/vnext/\n(the original VN/TX stage plan plus R/O tooling tickets) and emits a bounded\nprojection. It never writes canonical JSON and never infers completion from a\nsubstring of a status string.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nVNEXT_DIR = Path(\"docs\") / \"refactoring\" / \"vnext\"\nTICKETS_CANONICAL = VNEXT_DIR / \"tickets_production.json\"\nSTAGE_CANONICAL = VNEXT_DIR / \"stage_status.json\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/work/scripts/dev/status.py","text":"#!/usr/bin/env python3\n\"\"\"Deterministic read-only status projection for the v3 refactoring DAG.\n\nStdlib only. Reads the two canonical JSON files under docs/refactoring/vnext/\n(the original VN/TX stage plan plus R/O tooling tickets) and emits a bounded\nprojection. It never writes canonical JSON and never infers completion from a\nsubstring of a status string.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nVNEXT_DIR = Path(\"docs\") / \"refactoring\" / \"vnext\"\nTICKETS_CANONICAL = VNEXT_DIR / \"tickets_production.json\"\nSTAGE_CANONICAL = VNEXT_DIR / \"stage_status.json\"\n\nCOMPLETE_STAGE = \"COMPLETE_LOCAL_IMPLEMENTATION\"\nORIGINAL_STAGES = {COMPLETE_STAGE, \"INCOMPLETE\", \"NOT_STARTED\"}\nTOOLING_COMPLETE_STATUS = \"ACCEPTED\"\nRUNNING_STATUS = \"RUNNING\"\nACTIVE_EXECUTION_STATUSES = {\"RUNNING_LOCAL_REFACTORING\"}\nEXTERNAL_TASK_IDS = {\"VN20\"}\n\nSTATE_COMPLETE = \"COMPLETE\"\nSTATE_RUNNING = \"RUNNING\"\nSTATE_EXTERNAL = \"EXTERNAL\"\nSTATE_BLOCKED = \"BLOCKED\"\nSTATE_READY = \"READY\"\nSTATE_PAUSED = \"PAUSED_DISPATCH\"\n\n\ndef _load_json(path: Path) -> dict:\n    if not path.is_file():\n        raise ValueError(f\"canonical file missing: {path}\")\n    try:\n        with path.open(\"r\", encoding=\"utf-8\") as fh:\n            data = json.load(fh)\n    except (OSError, json.JSONDecodeError) as exc:\n        raise ValueError(f\"cannot parse {path}: {exc}\") from exc\n    if not isinstance(data, dict):\n        raise ValueError(f\"{path} must contain a JSON object\")\n    return data\n\n\ndef _require_str(value, label: str) -> str:\n    if not isinstance(value, str) or not value:\n        raise ValueError(f\"{label} must be a non-empty string\")\n    return value\n\n\ndef _require_str_list(value, label: str) -> list:\n    if not isinstance(value, list) or not all(isinstance(x, str) for x in value):\n        raise ValueError(f\"{label} must be a list of strings\")\n    return sorted(value)\n\n\ndef _execution_control(data: dict, label: str) -> dict:\n    ec = data.get(\"execution_control\")\n    if not isinstance(ec, dict):\n        raise ValueError(f\"{label}: execution_control object missing\")\n    status = _require_str(ec.get(\"status\"), f\"{label}: execution_control.status\")\n    if not isinstance(ec.get(\"start_next_ticket\"), bool):\n        raise ValueError(f\"{label}: execution_control.start_next_ticket must be boolean\")\n    last = _require_str(ec.get(\"last_completed_ticket\"), f\"{label}: execution_control.last_completed_ticket\")\n    return {\n        \"status\": status,\n        \"start_next_ticket\": ec[\"start_next_ticket\"],\n        \"last_completed_ticket\": last,\n        \"last_completed_tooling_ticket\": ec.get(\"last_completed_tooling_ticket\"),\n    }\n\n\ndef _collect_tasks(tickets: dict) -> tuple:\n    \"\"\"Validate IDs, dependencies and cycles; return (original, tooling) records.\"\"\"\n    tasks = tickets.get(\"tasks\")\n    tooling = tickets.get(\"tooling_tasks\", [])\n    if not isinstance(tasks, list) or not tasks:\n        raise ValueError(\"tickets_production.json: tasks must be a non-empty list\")\n    if not isinstance(tooling, list):\n        raise ValueError(\"tickets_production.json: tooling_tasks must be a list\")\n    records, tooling_records, seen = [], [], set()\n    for raw in tasks:\n        records.append(_record(raw, \"VN/TX\", \"tasks\", seen))\n    for raw in tooling:\n        tooling_records.append(_record(raw, \"R/O\", \"tooling_tasks\", seen))\n    known = seen\n    all_records = records + tooling_records\n    for rec in all_records:\n        for dep in rec[\"depends_on\"]:\n            if dep not in known:\n                raise ValueError(f\"{rec['task_id']} depends on unknown id: {dep}\")\n    _no_cycles(all_records)\n    return records, tooling_records\n\n\ndef _record(raw, family: str, label: str, seen: set) -> dict:\n    tid = _require_str(raw.get(\"task_id\"), f\"{label}[].task_id\")\n    if tid in seen:\n        raise ValueError(f\"duplicate task_id: {tid}\")\n    seen.add(tid)\n    return {\n        \"task_id\": tid,\n        \"family\": family,\n        \"status\": _require_str(raw.get(\"status\"), f\"{tid}.status\"),\n        \"depends_on\": _require_str_list(raw.get(\"depends_on\"), f\"{tid}.depends_on\"),\n        \"stage_classification\": raw.get(\"stage_classification\"),\n    }\n\n\ndef _no_cycles(records: list) -> None:\n    edges = {r[\"task_id\"]: r[\"depends_on\"] for r in records}\n    state: dict = {}\n\n    def visit(node: str) -> None:\n        if state.get(node) == 1:\n            raise ValueError(f\"dependency cycle involves {node}\")\n        if state.get(node) == 2:\n            return\n        state[node] = 1\n        for dep in edges[node]:\n            visit(dep)\n        state[node] = 2\n\n    for node in edges:\n        visit(node)\n\n\ndef _stage_authority(stage: dict, records: list) -> tuple:\n    \"\"\"Validate stage_status.json; return (category_by_id, declared_counts).\"\"\"\n    declared = stage.get(\"counts\")\n    tasks = stage.get(\"tasks\")\n    if not isinstance(declared, dict) or not declared:\n        raise ValueError(\"stage_status.json: counts object missing\")\n    if not isinstance(tasks, list) or not tasks:\n        raise ValueError(\"stage_status.json: tasks must be a non-empty list\")\n    category_by_id, tally, seen = {}, {}, set()\n    for raw in tasks:\n        tid = _require_str(raw.get(\"task_id\"), \"stage_status tasks[].task_id\")\n        if tid in seen:\n            raise ValueError(f\"duplicate stage task_id: {tid}\")\n        seen.add(tid)\n        category = _require_str(raw.get(\"category\"), f\"{tid}.category\")\n        if category not in ORIGINAL_STAGES:\n            raise ValueError(f\"{tid}: unknown stage category {category}\")\n        category_by_id[tid] = category\n        tally[category] = tally.get(category, 0) + 1\n    original_ids = {r[\"task_id\"] for r in records}\n    if seen != original_ids:\n        raise ValueError(\n            \"stage_status.json: stage tasks do not match original VN/TX records \"\n            f\"(missing={sorted(original_ids - seen)}, extra={sorted(seen - original_ids)})\"\n        )\n    for category in sorted(set(declared) | set(tally)):\n        declared_value = declared.get(category, 0)\n        if not isinstance(declared_value, int) or declared_value != tally.get(category, 0):\n            raise ValueError(\n                f\"stage count mismatch for {category}: declared={declared_value} \"\n                f\"actual={tally.get(category, 0)}\"\n            )\n    return category_by_id, dict(declared)\n\n\ndef load_status(root: Path) -> dict:\n    \"\"\"Build the deterministic read-only status projection (no writes).\"\"\"\n    root = Path(root)\n    tickets_path = root / TICKETS_CANONICAL\n    stage_path = root / STAGE_CANONICAL\n    tickets = _load_json(tickets_path)\n    stage_data = _load_json(stage_path)\n    tickets_ec = _execution_control(tickets, str(TICKETS_CANONICAL))\n    stage_ec = _execution_control(stage_data, str(STAGE_CANONICAL))\n    if tickets_ec[\"last_completed_ticket\"] != stage_ec[\"last_completed_ticket\"]:\n        raise ValueError(\n            \"last_completed_ticket conflict: \"\n            f\"tickets={tickets_ec['last_completed_ticket']} \"\n            f\"stage_status={stage_ec['last_completed_ticket']}\"\n        )\n    records, tooling_records = _collect_tasks(tickets)\n    category_by_id, stage_counts = _stage_authority(stage_data, records)\n\n    for rec in records:\n        if rec[\"stage_classification\"] is not None and rec[\"stage_classification\"] != category_by_id[rec[\"task_id\"]]:\n            raise ValueError(\n                f\"{rec['task_id']}: stage_classification {rec['stage_classification']!r} \"\n                f\"conflicts with stage category {category_by_id[rec['task_id']]!r}\"\n            )\n\n    all_records = records + tooling_records\n    ticket_ids = set(category_by_id)\n    complete_by_id: dict = {}\n    for rec in all_records:\n        if rec[\"family\"] == \"VN/TX\":\n            complete_by_id[rec[\"task_id\"]] = category_by_id[rec[\"task_id\"]] == COMPLETE_STAGE\n        else:\n            complete_by_id[rec[\"task_id\"]] = rec[\"status\"] == TOOLING_COMPLETE_STATUS\n\n    paused = any(ec[\"status\"] not in ACTIVE_EXECUTION_STATUSES for ec in (tickets_ec, stage_ec))\n    gates_open = not paused and tickets_ec[\"start_next_ticket\"] and stage_ec[\"start_next_ticket\"]\n\n    nodes = []\n    for rec in all_records:\n        tid = rec[\"task_id\"]\n        stage = category_by_id.get(tid)\n        running = rec[\"status\"] == RUNNING_STATUS\n        external = tid in EXTERNAL_TASK_IDS\n        missing = [dep for dep in rec[\"depends_on\"] if not complete_by_id[dep]]\n        ready = not complete_by_id[tid] and not running and not external and not missing and gates_open\n        if complete_by_id[tid]:\n            state = STATE_COMPLETE\n        elif running:\n            state = STATE_RUNNING\n        elif external:\n            state = STATE_EXTERNAL\n        elif missing:\n            state = STATE_BLOCKED\n        elif ready:\n            state = STATE_READY\n        else:\n            state = STATE_PAUSED\n        nodes.append(\n            {\n                \"task_id\": tid,\n                \"family\": rec[\"family\"],\n                \"status\": rec[\"status\"],\n                \"stage\": stage,\n                \"depends_on\": rec[\"depends_on\"],\n                \"complete\": complete_by_id[tid],\n                \"running\": running,\n                \"external\": external,\n                \"missing_dependencies\": missing,\n                \"state\": state,\n                \"ready\": ready,\n            }\n        )\n    tooling_tally: dict = {}\n    for node in nodes:\n        if node[\"family\"] == \"R/O\":\n            tooling_tally[node[\"status\"]] = tooling_tally.get(node[\"status\"], 0) + 1\n    return {\n        \"schema_version\": 1,\n        \"sources\": {\"tickets\": str(TICKETS_CANONICAL), \"stage_status\": str(STAGE_CANONICAL)},\n        \"execution_control\": {\n            \"tickets_status\": tickets_ec[\"status\"],\n            \"stage_status_status\": stage_ec[\"status\"],\n            \"start_next_ticket\": {\n                \"tickets\": tickets_ec[\"start_next_ticket\"],\n                \"stage_status\": stage_ec[\"start_next_ticket\"],\n            },\n            \"paused\": paused,\n        },\n        \"counts\": stage_counts,\n        \"tooling_counts\": tooling_tally,\n        \"node_totals\": {\"VN_TX\": len(records), \"RO\": len(tooling_records)},\n        \"ready\": [n[\"task_id\"] for n in nodes if n[\"ready\"]],\n        \"running\": [n[\"task_id\"] for n in nodes if n[\"running\"]],\n        \"external\": [n[\"task_id\"] for n in nodes if n[\"external\"]],\n        \"nodes\": nodes,\n        \"paused\": paused,\n        \"last_completed_ticket\": tickets_ec[\"last_completed_ticket\"],\n        \"last_completed_tooling_ticket\": tickets_ec[\"last_completed_tooling_ticket\"],\n    }\n\n\ndef render_markdown(status: dict, git_head: str) -> str:\n    lines = [\n        \"# Local status projection (v3)\",\n        \"\",\n        f\"Canonical sources: `{status['sources']['tickets']}`, `{status['sources']['stage_status']}`; \"\n        \"`context.json` is a bounded derived summary only.\",\n        f\"Git HEAD: `{git_head}`\",\n        \"\",\n        \"## Execution control\",\n        \"\",\n        f\"- tickets: `{status['execution_control']['tickets_status']}`; start_next_ticket=\"\n        f\"`{status['execution_control']['start_next_ticket']['tickets']}`\",\n        f\"- stage_status: `{status['execution_control']['stage_status_status']}`; start_next_ticket=\"\n        f\"`{status['execution_control']['start_next_ticket']['stage_status']}`\",\n        f\"- dispatch paused: `{status['paused']}`\",\n        \"\",\n        \"## Stage counts (VN/TX)\",\n        \"\",\n    ]\n    for category in sorted(status[\"counts\"]):\n        lines.append(f\"- {category}: {status['counts'][category]}\")\n    tooling = \", \".join(f\"{name} {value}\" for name, value in sorted(status[\"tooling_counts\"].items())) or \"none\"\n    lines += [\n        f\"- tooling (R/O): {tooling}\",\n        f\"- originals plus tooling: {status['node_totals']['VN_TX']} VN/TX nodes, \"\n        f\"{status['node_totals']['RO']} R/O nodes\",\n        \"\",\n        \"## Progress\",\n        \"\",\n        f\"- last completed ticket: `{status['last_completed_ticket']}`; last completed tooling \"\n        f\"ticket: `{status['last_completed_tooling_ticket']}`\",\n        f\"- running (no duplicate dispatch): {', '.join(f'`{x}`' for x in status['running']) or 'none'}\",\n        f\"- ready now (dispatch unlocked): {', '.join(f'`{x}`' for x in status['ready']) or 'none'}\",\n        f\"- external (never auto-run): {', '.join(f'`{x}`' for x in status['external']) or 'none'}\",\n        \"\",\n        \"Local/operational distinction: `COMPLETE_LOCAL_IMPLEMENTATION` marks local implementation\",\n        \"acceptance only; production, deploy and long-duration resource gates remain open. The\",\n        \"canonical record keeps the original VN/TX status strings, e.g. VN07 stays `INCOMPLETE` and\",\n        \"VN20 actual cutover/deletion is EXTERNAL and is never executed automatically.\",\n        \"\",\n    ]\n    return \"\\n\".join(lines)\n\n\ndef _git_head(root: Path) -> str:\n    \"\"\"Record the current Git HEAD; when unavailable, UNKNOWN is explicit.\"\"\"\n    try:\n        completed = subprocess.run(\n            [\"git\", \"rev-parse\", \"HEAD\"], cwd=str(root), capture_output=True, text=True, timeout=10\n        )\n    except (OSError, subprocess.SubprocessError):\n        return \"UNKNOWN\"\n    if completed.returncode != 0:\n        return \"UNKNOWN\"\n    return completed.stdout.strip() or \"UNKNOWN\"\n\n\ndef main(argv=None) -> int:\n    parser = argparse.ArgumentParser(description=\"Read-only v3 status projection (stdlib only).\")\n    parser.add_argument(\"--root\", default=\".\", help=\"repository root to read canonical JSON from\")\n    parser.add_argument(\"--json\", action=\"store_true\", help=\"emit JSON projection (default)\")\n    parser.add_argument(\"--markdown\", action=\"store_true\", help=\"render concise markdown status\")\n    args = parser.parse_args(argv)\n    try:\n        status = load_status(Path(args.root))\n    except ValueError as exc:\n        print(f\"status error: {exc}\", file=sys.stderr)\n        return 2\n    git_head = _git_head(Path(args.root))\n    if args.markdown:\n        print(render_markdown(status, git_head), end=\"\")\n    else:\n        status[\"git_head\"] = git_head\n        print(json.dumps(status, ensure_ascii=False, indent=2))\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())","lineStart":1,"lineEnd":347,"totalLines":347,"truncated":false}},"title":"scripts/dev/status.py","time":{"start":1792687885130,"end":1792687885153}},"id":"prt_164864a07001ov4zo0eQghDPDN","sessionID":"ses_e9b79d248ffe6pD2GFdVT2YUYs","messageID":"msg_164862fe10018HeizEtkbSRY2g"}}
