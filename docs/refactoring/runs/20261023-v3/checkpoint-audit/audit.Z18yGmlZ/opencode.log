   reader=await asyncio.to_thread(lambda:SpoolReader(item.spool_root,item.producer,item.incarnation,\n55: 231:                         after=SpoolCursor(initial.producer,initial.incarnation,initial.sequence),\n56: 232:                         **item.limits.reader_kwargs))\n57: 233:                     readers[c.producer]=reader\n58: 234:                 rows=await asyncio.to_thread(reader.read_batch,max_records=1,max_bytes=item.pipeline.max_bytes)\n59: 235:                 if len(rows)!=1:\n60: 236:                     raise RuntimeError('durable checkpoint suffix is incomplete')\n61: 237:                 row=rows[0]\n62: 238:                 frame=RecoveryFrame(EngineCursor(row.cursor.producer,row.cursor.incarnation,row.cursor.sequence),row.payload)\n63: 239:                 if AppliedReceipt(frame.cursor,frame.digest)!=receipt:\n64: 240:                     raise RuntimeError('checkpoint apply order payload mismatch')\n65: 241:                 engine.apply_replay(frame)\n66: 242:             return handoffs\n67: 243:         for initial,high in handoffs:\n68: 244:             if initial==high:continue\n69: 245:             item=items[initial.producer]\n70: 246:             reader=readers.get(initial.producer)\n71: 247:             if reader is None:\n72: 248:                 reader=await asyncio.to_thread(lambda:SpoolReader(item.spool_root,item.producer,item.incarnation,\n73: 249:                     after=SpoolCursor(initial.producer,initial.incarnation,initial.sequence),\n74: 250:                     **item.limits.reader_kwargs))\n75: 251:             while reader.cursor.sequence<high.sequence:\n76: 252:                 rows=await asyncio.to_thread(reader.read_batch,\n77: 253:                     max_records=min(item.pipeline.batch_records,high.sequence-reader.cursor.sequence),\n78: 254:                     max_bytes=item.pipeline.max_bytes)\n79: 255:                 if not rows:raise RuntimeError('durable checkpoint suffix is incomplete')\n80: 256:             