n\n25: 339:                 or isinstance(after.sequence, bool) or not isinstance(after.sequence, int)\n26: 340:                 or not 0 <= after.sequence <= report.durable_sequence):\n27: 341:             raise SpoolCorruption(\"reader start cursor exceeds durable prefix or has unknown incarnation\")\n28: 342:         self._sequence = after.sequence if after is not None else 0\n29: 343:         self._durable_sequence = report.durable_sequence\n30: 344:         self._segment_id = 1\n31: 345:         self._offset = 0\n32: 346:         self._identity: tuple[int, int] | None = None\n33: 347:         self._seen_size = 0\n34: 348:         self._sealed_signature: tuple[int, int] | None = None\n35: 349:         self._error: SpoolError | None = None\n36: 350:         if self._sequence:\n37: 351:             self._locate_start(report)\n38: 352: \n39: 353:     def _path(self, number: int) -> tuple[Path, bool]:\n40: 354:         sealed = self.root / f\"{number:020d}.sealed\"\n41: 355:         if sealed.exists():\n42: 356:             return sealed, True\n43: 357:         return self.root / f\"{number:020d}.active\", False\n44: 358: \n45: 359:     def _open_segment(self, number: int):\n46: 360:         sealed = self.root / f\"{number:020d}.sealed\"\n47: 361:         active = self.root / f\"{number:020d}.active\"\n48: 362:         # A segment transitions from active to sealed exactly once. Three\n49: 363:         # bounded opens cover that rename without reopening historical data.\n50: 364:         for path, is_sealed in ((sealed, True), (active, False), (sealed, True)):\n51: 365:             try:\n52: 366:                 return path, is_sealed, path.open(\"rb\")\n53: 367:             except FileNotFoundError:\n54: 368:                 continue\n55: 369:         raise SpoolCorruption(\"incremental reader segment is missing\")\n56: 370: \n57: 371:     def _locate_start(self, report: SpoolScan) -> None:\n58: 372:         # One startup-only streaming location pass. No per-record 